ontokin "0.17";
module Probe @ "probe";
profile "keyed-merge-0.1";

public fn left_values @ "left-values"()->Keyed<Int>{return map_keyed<Int>(keyed<Int>{"a":1,"b":2},(lk,ll)->ll); }
public fn right_values @ "right-values"()->Keyed<Int>{return map_keyed<Int>(keyed<Int>{"b":4,"a":3},(rk,rr)->rr); }

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Int> = keyed<Int>{"a":4,"b":6};
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
