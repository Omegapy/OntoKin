ontokin "0.17";
module Probe @ "probe";
profile "keyed-merge-0.1";
import lib @ "lib-import" from "fixture.zip-legacy" version "1.0.0" digest "sha256:f2d2087558f0ce85ed0a0c99c9816e0284f9a4a210cde7d21ae01161b702a629";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Int> = keyed<Int>{"a":7};
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
