ontokin "0.17";
module Probe @ "probe";
profile "keyed-merge-0.1";

public fn combine @ "combine"(aa: Keyed<Int>,bb: Keyed<Int>)->Keyed<Int>{return keyed<Int>{"a":aa["a"]+bb["a"]};}

public class ProbeShape @ "probe-shape" {
    public param left_items @ "left-items": Keyed<Int> = keyed<Int>{"a":2}; public param right_items @ "right-items": Keyed<Int> = keyed<Int>{"a":3}; public param unused @ "unused": Int = 99; public param selected @ "selected": Bool = true; public derive earlier @ "earlier": Keyed<Int> = combine(self.left_items,self.right_items);
    public derive result @ "result": Keyed<Int> = if len(self.earlier)==1 then combine(self.left_items,self.right_items) else keyed<Int>{};
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
