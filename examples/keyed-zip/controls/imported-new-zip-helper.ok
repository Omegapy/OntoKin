ontokin "0.17";
module Probe @ "probe";
profile "keyed-merge-0.1";
import lib @ "lib-import" from "fixture.zip-helper" version "1.0.0" digest "sha256:910a1d440c0d1edb9b8de07eefbf88afaaaca89f917ca36d39ec1cf6c1851991";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Int> = lib.combine(keyed<Int>{"a":2},keyed<Int>{"a":3});
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
