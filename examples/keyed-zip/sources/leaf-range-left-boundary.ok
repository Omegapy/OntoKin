ontokin "0.18";
module Probe @ "probe";
profile "keyed-zip-0.1";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Int> = zip_keyed<Range<Length>, Int, Int>(keyed<Range<Length>>{"a": range(1[m], 2[m])}, keyed<Int>{"a": 7}, (key, lv, rv) -> rv);
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
