ontokin "0.18";
module Probe @ "probe";
profile "keyed-zip-0.1";

public fn with_captured @ "with-captured"(captured:Int)->Keyed<Int>{return zip_keyed<Int, Int, Int>(keyed<Int>{"a":2}, keyed<Int>{"a":3}, (ck, cl, cr) -> cl+cr+captured);}

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Int> = with_captured((zip_keyed<Int, Int, Int>(keyed<Int>{"foreign":1}, keyed<Int>{"foreign":3}, (fk, fl, fr) -> fl+fr))["foreign"]);
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
