ontokin "0.18";
module Probe @ "probe";
profile "keyed-zip-0.1";

public fn combine @ "combine"(aa: Keyed<Int>,bb: Keyed<Int>)->Keyed<Int>{return zip_keyed<Int, Int, Int>(aa, bb, (key, lv, rv) -> lv+rv);}

public class ProbeShape @ "probe-shape" {
    public param left_items @ "left-items": Keyed<Int> = keyed<Int>{}; public param right_items @ "right-items": Keyed<Int> = keyed<Int>{}; public param threshold @ "threshold": Int = 9; public derive earlier @ "earlier": Keyed<Int> = combine(self.left_items,self.right_items);
    public derive result @ "result": Keyed<Int> = if len(self.earlier)==0 then combine(self.left_items,self.right_items) else keyed<Int>{};
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
