ontokin "0.18";
module Probe @ "probe";
profile "keyed-zip-0.1";


public class ProbeShape @ "probe-shape" {
    public param left_items @ "left-items": Keyed<Int> = keyed<Int>{"a":2}; public param right_items @ "right-items": Keyed<Int> = keyed<Int>{"a":3}; public param unused @ "unused": Int = 99; public param selected @ "selected": Bool = true;
    public derive result @ "result": Keyed<Int> = zip_keyed<Int, Int, Int>(self.left_items, self.right_items, (key, lv, rv) -> rv);
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
