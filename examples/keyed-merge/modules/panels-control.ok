ontokin "0.16";
module Panels @ "panels";
profile "keyed-filter-0.1";

public class Panel @ "panel" {
    public param width @ "width": Length = 1[m];
    public param parent_frame @ "parent-frame": FrameRef = world;
    public param mount_x @ "mount-x": Length = 0[m];
    public follow mounting @ "mounting" {
        parent = self.parent_frame;
        child = self;
        offset = pose(self.parent_frame, vec3(self.mount_x, 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    geometry = texture_surface(extrude(keyed<PolygonVertex> {
        "v0": polygon_vertex(0, planar_point(0[m], 0[m]), "side"),
        "v1": polygon_vertex(10, planar_point(self.width, 0[m]), "side"),
        "v2": polygon_vertex(20, planar_point(self.width, 2[m]), "side"),
        "v3": polygon_vertex(30, planar_point(0[m], 2[m]), "side")
    }, keyed<SurfaceMaterial> {
        "bottom": surface_material(rgba(1, 1, 1, 1), 0, 0.7),
        "side": surface_material(rgba(0.25, 0.5, 0.75, 1), 0, 0.7),
        "top": surface_material(rgba(1, 1, 1, 1), 0, 0.7)
    }, 0.25[m], "bottom", "top"), keyed<TextureBinding> {
        "top": texture_binding(png_asset("label", "sha256:5f87c7071d06327a077e05e1f57253370bc0b2eff1fa7f2025765825b7dcdd6e"), planar_uv(vec3(0[m], 0[m], 0[m]),
            vec3(0.5[m^-1], 0[m^-1], 0[m^-1]), vec3(0[m^-1], -0.5[m^-1], 0[m^-1]), 0, 1))
    });
    physical = no_body();
}
public class PanelGroup @ "panel-group" {
    public param include_optional @ "include-optional": Bool = false;
    public param coefficients @ "coefficients": Keyed<Real> = keyed<Real>{"right": 2, "left": 1};
    public param optional_coefficients @ "optional-coefficients": Keyed<Real> = keyed<Real>{"vent": 0.5};
    public param mounts @ "mounts": Keyed<Length> = keyed<Length>{"left": 0[m], "right": 4[m], "vent": 6.5[m]};
    public derive standard @ "standard": Keyed<Length> = map_keyed<Length>(self.coefficients, (sk, sv) -> sv * 1[m]);
    public derive optional_candidates @ "optional-candidates": Keyed<Length> = map_keyed<Length>(self.optional_coefficients, (ok, ov) -> ov * 1[m]);
    public derive optional @ "optional": Keyed<Length> = filter_keyed<Length>(self.optional_candidates, (fk, fv) -> self.include_optional);
    public derive widths @ "widths": Keyed<Length> = if self.include_optional then keyed<Length>{"left": 1[m], "right": 2[m], "vent": 0.5[m]} else keyed<Length>{"left": 1[m], "right": 2[m]};
    public derive selected_total @ "selected-total": Length = reduce_keyed<Length>(self.widths, 0[m], (acc, rk, rv) -> acc + rv);
    public parts panels @ "panels": Panel for (panel_key, panel_width) in self.widths {
        width = panel_width;
        parent_frame = self.frame;
        mount_x = self.mounts[panel_key];
    }
    geometry = if self.selected_total >= 0[m] then empty() else empty();
    physical = no_body();
}
