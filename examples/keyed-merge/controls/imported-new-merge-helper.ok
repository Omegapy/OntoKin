ontokin "0.16";
module Probe @ "probe";
profile "keyed-filter-0.1";
import lib @ "lib-import" from "fixture.merge-helper" version "1.0.0" digest "sha256:68d17fb23d6b1bcefcca64c1f8ff145f0e1f37e2e671c4b25ff106034b0b6008";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Int> = lib.combine(keyed<Int>{"a": 1}, keyed<Int>{"b": 2});
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
