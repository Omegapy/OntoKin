ontokin "0.16";
module Probe @ "probe";
profile "keyed-filter-0.1";

public fn combine @ "combine"(left_items: Keyed<Int>, right_items: Keyed<Int>) -> Keyed<Int> { return keyed<Int>{"a": left_items["a"], "b": right_items["b"]}; }

public class ProbeShape @ "probe-shape" {
    public param original @ "original": Keyed<Int> = keyed<Int>{"a": 1}; public param optional @ "optional": Keyed<Int> = keyed<Int>{"b": 2}; public derive earlier @ "earlier": Keyed<Int> = combine(self.original, self.optional);
    public derive result @ "result": Keyed<Int> = if len(self.earlier) == 2 then combine(self.original, self.optional) else keyed<Int>{};
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
