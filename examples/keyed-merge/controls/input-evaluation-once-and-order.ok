ontokin "0.16";
module Probe @ "probe";
profile "keyed-filter-0.1";

public fn left_group @ "left-group"() -> Keyed<Int> { return map_keyed<Int>(keyed<Int>{"left": 1}, (lk, lv) -> lv); }
public fn right_group @ "right-group"() -> Keyed<Int> { return map_keyed<Int>(keyed<Int>{"right": 2}, (rk, rv) -> rv); }

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Int> = keyed<Int>{"left": 1, "right": 2};
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
