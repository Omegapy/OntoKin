ontokin "0.17";
module Probe @ "probe";
profile "keyed-merge-0.1";
import lib @ "lib-import" from "fixture.merge-helper" version "1.0.0" digest "sha256:59a465e4b0a91da7a6b0431ca335520f65929a01de7cc9547661be61bbed3e41";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Int> = lib.combine(keyed<Int>{"a": 1}, keyed<Int>{"b": 2});
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
