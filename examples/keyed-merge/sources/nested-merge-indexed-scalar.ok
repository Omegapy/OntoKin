ontokin "0.17";
module Probe @ "probe";
profile "keyed-merge-0.1";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Int = (merge_keyed<Int>(merge_keyed<Int>(keyed<Int>{"a": 1}, keyed<Int>{"b": 2}), keyed<Int>{"c": 3}))["a"];
    public derive forced @ "forced": Int = len(keyed<Int>{"result": self.result});
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
