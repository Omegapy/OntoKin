ontokin "0.17";
module Probe @ "probe";
profile "keyed-merge-0.1";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<SurfaceMaterial> = merge_keyed<SurfaceMaterial>(keyed<SurfaceMaterial>{"same": surface_material(rgba(1, 1, 1, 1), 0, 0.5)}, keyed<SurfaceMaterial>{"same": surface_material(rgba(1, 1, 1, 1), 2, 0.5)});
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
