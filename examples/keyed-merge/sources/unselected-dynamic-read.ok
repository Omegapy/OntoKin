ontokin "0.17";
module Probe @ "probe";
profile "keyed-merge-0.1";


public class ProbeShape @ "probe-shape" {
    public param left_empty @ "left-empty": Keyed<Int> = keyed<Int>{}; public param right_empty @ "right-empty": Keyed<Int> = keyed<Int>{}; public param threshold @ "threshold": Int = 9; public param selected @ "selected": Bool = true;
    public derive result @ "result": Keyed<Int> = merge_keyed<Int>(if true then keyed<Int>{"a": 1} else keyed<Int>{"x": self.threshold}, keyed<Int>{});
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
