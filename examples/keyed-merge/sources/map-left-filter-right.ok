ontokin "0.17";
module Probe @ "probe";
profile "keyed-merge-0.1";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Length> = merge_keyed<Length>(map_keyed<Length>(keyed<Int>{"a": 1, "b": 2}, (mk, mv) -> mv * 0.5[m]), filter_keyed<Length>(keyed<Length>{"c": 0.25[m], "d": 2[m]}, (fk, fv) -> fv >= 1[m]));
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
