ontokin "0.12";
module TextureCase @ "texture-case";
profile "polygon-pockets-0.1";


public class Shape @ "shape" {
    geometry = extrude(keyed<PolygonVertex> {
        "v0": polygon_vertex(0, planar_point(0[m], 0[m]), "side"),
        "v1": polygon_vertex(10, planar_point(4[m], 0[m]), "side"),
        "v2": polygon_vertex(20, planar_point(4[m], 2[m]), "side"),
        "v3": polygon_vertex(30, planar_point(0[m], 2[m]), "side")
    }, keyed<SurfaceMaterial> {
        "bottom": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "side": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "top": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused0": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused1": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused2": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused3": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused4": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused5": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused6": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused7": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused8": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused9": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused10": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused11": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7),
        "unused12": surface_material(rgba(1, 1, 1, 1), 0.0, 0.7)
    }, 0.25[m], "bottom", "top");
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": Shape {
        placement = pose(world, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(shape, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
