ontokin "0.13";
module TextureCase @ "texture-case";
profile "textured-surfaces-0.1";


public class Shape @ "shape" {
    geometry = texture_surface(sphere(1[m]), keyed<TextureBinding> { "top": texture_binding(png_asset("label", "sha256:5f87c7071d06327a077e05e1f57253370bc0b2eff1fa7f2025765825b7dcdd6e"), planar_uv(vec3(0[m], 0[m], 0[m]), vec3(0.25[m^-1], 0[m^-1], 0[m^-1]), vec3(0[m^-1], -0.5[m^-1], 0[m^-1]), 0, 1)) });
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": Shape {
        placement = pose(world, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(shape, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
