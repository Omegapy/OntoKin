ontokin "0.9";
module HoleCase @ "hole-case";
profile "polygon-holes-0.1";

public class Shape @ "shape" {
    public param rings @ "rings": Keyed<PolygonRing> = keyed<PolygonRing> {
        "outer": polygon_ring(0, "outer", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(0[m], 0[m]), "outer"),
            "v1": polygon_vertex(10, planar_point(10[m], 0[m]), "outer"),
            "v2": polygon_vertex(20, planar_point(10[m], 10[m]), "outer"),
            "v3": polygon_vertex(30, planar_point(0[m], 10[m]), "outer")
        }),
        "opening-0": polygon_ring(10, "hole", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(1[m], 2[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(2[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(2[m], 1[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(1[m], 1[m]), "inner")
        }),
        "opening-1": polygon_ring(20, "hole", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(4[m], 2[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(5[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(5[m], 1[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(4[m], 1[m]), "inner")
        }),
        "opening-2": polygon_ring(30, "hole", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(7[m], 2[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(8[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(8[m], 1[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(7[m], 1[m]), "inner")
        }),
        "opening-3": polygon_ring(40, "hole", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(1[m], 5[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(2[m], 5[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(2[m], 4[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(1[m], 4[m]), "inner")
        }),
        "opening-4": polygon_ring(50, "hole", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(4[m], 5[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(5[m], 5[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(5[m], 4[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(4[m], 4[m]), "inner")
        }),
        "opening-5": polygon_ring(60, "hole", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(7[m], 5[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(8[m], 5[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(8[m], 4[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(7[m], 4[m]), "inner")
        }),
        "opening-6": polygon_ring(70, "hole", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(1[m], 8[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(2[m], 8[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(2[m], 7[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(1[m], 7[m]), "inner")
        }),
        "opening-7": polygon_ring(80, "hole", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(4[m], 8[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(5[m], 8[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(5[m], 7[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(4[m], 7[m]), "inner")
        }),
        "opening-8": polygon_ring(90, "hole", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(7[m], 8[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(8[m], 8[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(8[m], 7[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(7[m], 7[m]), "inner")
        })
    };
    public param depth @ "depth": Length = 0.5[m];
    public param palette @ "palette": Keyed<SurfaceMaterial> = keyed<SurfaceMaterial> {
        "bottom": surface_material(rgba(0.3, 0.35, 0.4, 1), 0.1, 0.65),
        "inner": surface_material(rgba(0.15, 0.65, 0.3, 1), 0.1, 0.65),
        "outer": surface_material(rgba(0.7, 0.3, 0.1, 1), 0.1, 0.65),
        "top": surface_material(rgba(0.1, 0.5, 0.8, 1), 0.1, 0.65)
    };
    geometry = extrude_rings(self.rings, self.palette, self.depth, "bottom", "top");
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": Shape {
        placement = pose(world, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(shape, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
