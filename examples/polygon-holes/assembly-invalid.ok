ontokin "0.9";
module HoleAssembly @ "hole-assembly";
profile "polygon-holes-0.1";

import libparts @ "hole-parts" from "fixture.hole-parts" version "1.0.0"
    digest "sha256:59595ff61192eaec757aaa893346aae6edc29c6d45883d27a3fb2695c183aeed";

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object first @ "first": libparts.Shape {
        placement = pose(world, vec3(-3[m], 0[m], 0[m]), quat(1, 0, 0, 0));
        rings = keyed<PolygonRing> {
            "outer": polygon_ring(20, "outer", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(0[m], 0[m]), "outer"),
                "v1": polygon_vertex(10, planar_point(4[m], 0[m]), "outer"),
                "v2": polygon_vertex(20, planar_point(4[m], 4[m]), "outer"),
                "v3": polygon_vertex(30, planar_point(0[m], 4[m]), "outer")
            }),
            "opening": polygon_ring(40, "hole", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(0[m], 3[m]), "inner"),
                "v1": polygon_vertex(10, planar_point(3[m], 3[m]), "inner"),
                "v2": polygon_vertex(20, planar_point(3[m], 1[m]), "inner"),
                "v3": polygon_vertex(30, planar_point(1[m], 1[m]), "inner")
            })
        };
    }
    object sibling @ "sibling": libparts.Shape {
        placement = pose(world, vec3(3[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(first, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
