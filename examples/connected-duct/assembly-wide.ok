ontokin "0.11";
module ConnectedDuct @ "connected-duct";
profile "framed-polygon-loft-0.1";

import ducts @ "duct-parts" from "example.connected-duct-parts" version "1.0.0"
    digest "sha256:6ec8296709e9f2f31215dbb9056f829aa5fff48302f2e12e63662d94bfff06fb";

public fn wide_half_bore @ "wide-half-bore"() -> Length {
    return 0.625[m];
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object elbow @ "elbow": ducts.Elbow {
        bore_half = wide_half_bore();
        placement = pose(world, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    object straight @ "straight": ducts.Straight {
        bore_half = wide_half_bore();
        placement = pose(world, vec3(4[m], 0[m], 4[m]), quat(0.7071067811865476, 0, 0.7071067811865476, 0));
        bore_shift = 0[m];
    }
}
