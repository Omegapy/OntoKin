ontokin "0.19";
module Probe @ "probe";
profile "keyed-rekey-0.1";

public fn empty_name @ "empty-name"(zero: Real) -> Keyed<Int> { return rekey_keyed<Int>(keyed<Int>{}, (old_key, payload) -> if 1.0 / zero > 0.0 then "a" else "b"); }
public class ProbeShape @ "probe-shape" {
    public derive result @ "result": Keyed<Int> = empty_name(0.0);
    public derive forced @ "forced": Int = len(self.result);
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
