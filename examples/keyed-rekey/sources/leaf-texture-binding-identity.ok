ontokin "0.19";
module Probe @ "probe";
profile "keyed-rekey-0.1";


public class ProbeShape @ "probe-shape" {
    public derive result @ "result": Keyed<TextureBinding> = rekey_keyed<TextureBinding>(keyed<TextureBinding>{"a": texture_binding(png_asset("label", "sha256:5f87c7071d06327a077e05e1f57253370bc0b2eff1fa7f2025765825b7dcdd6e"), planar_uv(vec3(0[m], 0[m], 0[m]), vec3(1[m^-1], 0[m^-1], 0[m^-1]), vec3(0[m^-1], 1[m^-1], 0[m^-1]), 0, 0))}, (old_key, payload) -> old_key);
    public derive forced @ "forced": Int = len(self.result);
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
