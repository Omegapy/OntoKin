ontokin "0.19";
module Probe @ "probe";
profile "keyed-rekey-0.1";

public fn renamed @ "renamed"(aa:Keyed<Int>) -> Keyed<Int> {return rekey_keyed<Int>(aa, (hk,hv) -> "ns.a");}
public class ProbeShape @ "probe-shape" {
    public param items @ "items": Keyed<Int> = keyed<Int>{"a":7}; public derive earlier @ "earlier": Keyed<Int> = renamed(self.items);
    public derive result @ "result": Keyed<Int> = if len(self.earlier)==1 then renamed(self.items) else keyed<Int>{};
    public derive forced @ "forced": Int = len(self.result);
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
