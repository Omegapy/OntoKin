ontokin "0.19";
module Probe @ "probe";
profile "keyed-rekey-0.1";
import lib @ "lib-import" from "fixture.rekey-legacy" version "1.0.0" digest "sha256:c04044b328b7b949ee6a000f5ce32f917a7b1bbc08378887a4bcbd1bd1b8679b";


public class ProbeShape @ "probe-shape" {
    public derive result @ "result": Keyed<Int> = rekey_keyed<Int>(keyed<Int>{}, (old_key, payload) -> lib.hidden());
    public derive forced @ "forced": Int = len(self.result);
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
