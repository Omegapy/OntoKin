ontokin "0.19";
module Probe @ "probe";
profile "keyed-rekey-0.1";


public class ProbeShape @ "probe-shape" {
    public derive result @ "result": Keyed<PlanarUV> = rekey_keyed<PlanarUV>(keyed<PlanarUV>{"a": planar_uv(vec3(0[m], 0[m], 0[m]), vec3(1[m^-1], 0[m^-1], 0[m^-1]), vec3(0[m^-1], 1[m^-1], 0[m^-1]), 0, 0)}, (old_key, payload) -> "ns.a");
    public derive forced @ "forced": Int = len(self.result);
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
