ontokin "0.19";
module Dependencies @ "dependencies";
profile "keyed-rekey-0.1";
public class Leaf @ "leaf" {
 public param size @ "size": Length = 0.25[m];
 geometry = sphere(self.size);
 physical = no_body();
}
public class Family @ "family" {
 public param sizes @ "sizes": Keyed<Length> = keyed<Length>{"a": 0.25[m], "z": 0.5[m]};
 
 public parts leaves @ "leaves": Leaf for (child_key, child_value) in self.sizes { size = child_value; }
 geometry = empty();
 physical = no_body();
}
public class Outer @ "outer" {
 public part family @ "family-part": Family {}
 public derive copied @ "copied": Length = self.family.leaves["a"].size;
 public parts bad @ "bad": Leaf for (child_key, child_value) in if len(rekey_keyed<Length>(filter_keyed<Length>(keyed<Length>{"x": self.copied}, (fk, fv) -> false), (old_key, payload) -> old_key)) == 0 then keyed<Length>{} else keyed<Length>{} { size = child_value; }
 geometry = empty();
 physical = no_body();
}
scene Demo @ "demo" {
 duration = 1[s];
 gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
 object rig @ "rig": Outer {}
}
