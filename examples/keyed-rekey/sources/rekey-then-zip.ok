ontokin "0.19";
module Probe @ "probe";
profile "keyed-rekey-0.1";


public class ProbeShape @ "probe-shape" {
    public derive result @ "result": Keyed<Int> = zip_keyed<Int,Int,Int>(rekey_keyed<Int>(keyed<Int>{"a":2}, (old_key, payload) -> "ns.a"), keyed<Int>{"ns.a":3}, (zk, zl, zr) -> zl+zr);
    public derive forced @ "forced": Int = len(self.result);
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
