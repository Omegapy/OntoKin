ontokin "0.18";
module Probe @ "probe";
profile "keyed-zip-0.1";
import lib @ "lib-import" from "fixture.rekey-helper" version "1.0.0" digest "sha256:f39a80dc58894c7b275804668a668efe91cdf6ce72fc089a56afc5007d666f5b";


public class ProbeShape @ "probe-shape" {
    public derive result @ "result": Keyed<Int> = lib.names(keyed<Int>{"a":7});
