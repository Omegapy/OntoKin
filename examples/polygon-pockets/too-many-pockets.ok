ontokin "0.12";
module PocketCase @ "pocket-case";
profile "polygon-pockets-0.1";

public class Shape @ "shape" {
    public param outer_vertices @ "outer-vertices": Keyed<PolygonVertex> = keyed<PolygonVertex> {
        "v0": polygon_vertex(0, planar_point(0[m], 0[m]), "outer"),
        "v1": polygon_vertex(10, planar_point(20[m], 0[m]), "outer"),
        "v2": polygon_vertex(20, planar_point(20[m], 4[m]), "outer"),
        "v3": polygon_vertex(30, planar_point(0[m], 4[m]), "outer")
    };
    public param pockets @ "pockets": Keyed<PolygonPocket> = keyed<PolygonPocket> {
        "p0": polygon_pocket(0, keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(0.5[m], 1[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(0.5[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(1.5[m], 2[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(1.5[m], 1[m]), "inner")
        }, 0.5[m], "floor"),
        "p1": polygon_pocket(1, keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(2.5[m], 1[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(2.5[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(3.5[m], 2[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(3.5[m], 1[m]), "inner")
        }, 0.5[m], "floor"),
        "p2": polygon_pocket(2, keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(4.5[m], 1[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(4.5[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(5.5[m], 2[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(5.5[m], 1[m]), "inner")
        }, 0.5[m], "floor"),
        "p3": polygon_pocket(3, keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(6.5[m], 1[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(6.5[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(7.5[m], 2[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(7.5[m], 1[m]), "inner")
        }, 0.5[m], "floor"),
        "p4": polygon_pocket(4, keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(8.5[m], 1[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(8.5[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(9.5[m], 2[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(9.5[m], 1[m]), "inner")
        }, 0.5[m], "floor"),
        "p5": polygon_pocket(5, keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(10.5[m], 1[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(10.5[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(11.5[m], 2[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(11.5[m], 1[m]), "inner")
        }, 0.5[m], "floor"),
        "p6": polygon_pocket(6, keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(12.5[m], 1[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(12.5[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(13.5[m], 2[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(13.5[m], 1[m]), "inner")
        }, 0.5[m], "floor"),
        "p7": polygon_pocket(7, keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(14.5[m], 1[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(14.5[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(15.5[m], 2[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(15.5[m], 1[m]), "inner")
        }, 0.5[m], "floor"),
        "p8": polygon_pocket(8, keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(16.5[m], 1[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(16.5[m], 2[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(17.5[m], 2[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(17.5[m], 1[m]), "inner")
        }, 0.5[m], "floor")
    };
    public param height @ "height": Length = 2[m];
    public param palette @ "palette": Keyed<SurfaceMaterial> = keyed<SurfaceMaterial> {
        "bottom": surface_material(rgba(0.3, 0.35, 0.4, 1), 0.1, 0.65),
        "floor": surface_material(rgba(0.85, 0.65, 0.15, 1), 0.1, 0.65),
        "inner": surface_material(rgba(0.15, 0.65, 0.3, 1), 0.1, 0.65),
        "outer": surface_material(rgba(0.7, 0.3, 0.1, 1), 0.1, 0.65),
        "top": surface_material(rgba(0.1, 0.5, 0.8, 1), 0.1, 0.65)
    };
    geometry = extrude_pockets(self.outer_vertices, self.pockets, self.palette, self.height, "bottom", "top");
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": Shape {
        placement = pose(world, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(shape, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
