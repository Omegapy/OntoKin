ontokin "0.2";
module KeyedRack @ "keyed-rack";
profile "construction-0.1";

// The pin below is the SHA-256 of the exact companion hinges.ok bytes.
import mech @ "mechanics" from "example.hinges" version "1.0.0"
    digest "sha256:1516e53179a7b9deecf593ab48afdcd72fba8124ea77868327c25a28a654681a";

public class Rack @ "rack" {
    public param mounts @ "mounts": Keyed<Vec3<Length>> = mech.three_mounts(0.6[m]);
    public param finger_length @ "finger-length": Length = 0.6[m];
    geometry = box(vec3(0.1[m], 0.6[m] * real(len(self.mounts)), 0.1[m]));
    appearance = rgba(0.45, 0.45, 0.5, 1);
    public parts fingers @ "fingers": mech.Finger for (key, offset) in self.mounts {
        parent_frame = self.frame;
        mount_offset = offset;
        length = self.finger_length;
    }
}

scene Demo @ "demo" {
    duration = 2[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object first @ "first": Rack {
        placement = pose(world, vec3(-1[m], 0[m], 0[m]), quat(1, 0, 0, 0));
        fingers["middle"].length = 0.65[m];
    }
    object second @ "second": Rack {
        placement = pose(world, vec3(1[m], 0[m], 0[m]), quat(1, 0, 0, 0));
        mounts = keyed<Vec3<Length>> {
            "bottom": vec3(0[m], -1.2[m], 0[m]),
            "lower": vec3(0[m], -0.6[m], 0[m]),
            "middle": vec3(0[m], 0[m], 0[m]),
            "upper": vec3(0[m], 0.6[m], 0[m]),
            "top": vec3(0[m], 1.2[m], 0[m])
        };
    }
    action flex @ "flex" = first.fingers["middle"].bend_to(45[deg], 1[s]);
    action travel @ "travel" =
        move(first, vector(world, 0[m/s], 0.2[m/s], 0[m/s]), 2[s]);
    at 0[s] sequence {
        start flex;
        start travel;
    }
}
