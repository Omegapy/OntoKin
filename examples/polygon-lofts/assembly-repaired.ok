ontokin "0.10";
module RingLoftAssembly @ "ring-loft-assembly";
profile "polygon-loft-0.1";

import libparts @ "ring-loft-parts" from "fixture.ring-loft-parts" version "1.0.0"
    digest "sha256:19a3f8810af05bbb1fa9c1e5f3826a95c07a1e91307ec727a4125f807af125c7";

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object first @ "first": libparts.Shape {
        placement = pose(world, vec3(-3[m], 0[m], 0[m]), quat(1, 0, 0, 0));
        upper_rings = keyed<PolygonRing> {
            "outer": polygon_ring(20, "outer", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(-1[m], -1[m]), "outer"),
                "v1": polygon_vertex(10, planar_point(1[m], -1[m]), "outer"),
                "v2": polygon_vertex(20, planar_point(1[m], 1[m]), "outer"),
                "v3": polygon_vertex(30, planar_point(-1[m], 1[m]), "outer")
            }),
            "opening": polygon_ring(40, "hole", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(-0.5[m], 0.5[m]), "inner"),
                "v1": polygon_vertex(10, planar_point(0.25[m], 0.5[m]), "inner"),
                "v2": polygon_vertex(20, planar_point(0.5[m], -0.5[m]), "inner"),
                "v3": polygon_vertex(30, planar_point(-0.5[m], -0.5[m]), "inner")
            })
        };
    }
    object sibling @ "sibling": libparts.Shape {
        placement = pose(world, vec3(3[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(first, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
