            }),
            "h2": polygon_ring(60, "hole", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(-2.25[m], 0.25[m]), "inner"),
                "v1": polygon_vertex(10, planar_point(-1.75[m], 0.25[m]), "inner"),
                "v2": polygon_vertex(20, planar_point(-1.75[m], -0.25[m]), "inner"),
