            }),
            "h4": polygon_ring(80, "hole", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(-0.25[m], 0.25[m]), "inner"),
                "v1": polygon_vertex(10, planar_point(0.25[m], 0.25[m]), "inner"),
                "v2": polygon_vertex(20, planar_point(0.25[m], -0.25[m]), "inner"),
                "v3": polygon_vertex(30, planar_point(-0.25[m], -0.25[m]), "inner")
            }),
            "h5": polygon_ring(90, "hole", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(0.75[m], 0.25[m]), "inner"),
                "v1": polygon_vertex(10, planar_point(1.25[m], 0.25[m]), "inner"),
                "v2": polygon_vertex(20, planar_point(1.25[m], -0.25[m]), "inner"),
                "v3": polygon_vertex(30, planar_point(0.75[m], -0.25[m]), "inner")
            }),
            "h6": polygon_ring(100, "hole", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(1.75[m], 0.25[m]), "inner"),
                "v1": polygon_vertex(10, planar_point(2.25[m], 0.25[m]), "inner"),
                "v2": polygon_vertex(20, planar_point(2.25[m], -0.25[m]), "inner"),
                "v3": polygon_vertex(30, planar_point(1.75[m], -0.25[m]), "inner")
            }),
            "h7": polygon_ring(110, "hole", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(2.75[m], 0.25[m]), "inner"),
                "v1": polygon_vertex(10, planar_point(3.25[m], 0.25[m]), "inner"),
                "v2": polygon_vertex(20, planar_point(3.25[m], -0.25[m]), "inner"),
                "v3": polygon_vertex(30, planar_point(2.75[m], -0.25[m]), "inner")
            }),
            "h8": polygon_ring(120, "hole", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(3.75[m], 0.25[m]), "inner"),
                "v1": polygon_vertex(10, planar_point(4.25[m], 0.25[m]), "inner"),
                "v2": polygon_vertex(20, planar_point(4.25[m], -0.25[m]), "inner"),
                "v3": polygon_vertex(30, planar_point(3.75[m], -0.25[m]), "inner")
            })
        })
    };
    public param palette @ "palette": Keyed<SurfaceMaterial> = keyed<SurfaceMaterial> {
        "bottom": surface_material(rgba(0.3, 0.35, 0.4, 1), 0.1, 0.65),
        "inner": surface_material(rgba(0.15, 0.65, 0.3, 1), 0.1, 0.65),
        "outer": surface_material(rgba(0.7, 0.3, 0.1, 1), 0.1, 0.65),
        "top": surface_material(rgba(0.1, 0.5, 0.8, 1), 0.1, 0.65)
    };
    geometry = loft_rings(self.sections, self.palette, "bottom", "top");
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": Shape {
        placement = pose(world, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(shape, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
