                "v2": polygon_vertex(20, planar_point(-1.75[m], -0.25[m]), "inner"),
                "v3": polygon_vertex(30, planar_point(-2.25[m], -0.25[m]), "inner")
            }),
            "h3": polygon_ring(70, "hole", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(-1.25[m], 0.25[m]), "inner"),
