ontokin "0.10";
module RingLoftCase @ "ring-loft-case";
profile "polygon-loft-0.1";

public class Shape @ "shape" {
    public param sections @ "sections": Keyed<PolygonSection> = keyed<PolygonSection> {
        "s0": polygon_section(10, 0[m], keyed<PolygonRing> {
            "outer": polygon_ring(20, "outer", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(-10[m], -10[m]), "outer"),
                "v1": polygon_vertex(10, planar_point(10[m], -10[m]), "outer"),
                "v2": polygon_vertex(20, planar_point(10[m], 10[m]), "outer"),
                "v3": polygon_vertex(30, planar_point(-10[m], 10[m]), "outer")
            }),
            "h0": polygon_ring(40, "hole", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(-4.25[m], 0.25[m]), "inner"),
                "v1": polygon_vertex(10, planar_point(-3.75[m], 0.25[m]), "inner"),
                "v2": polygon_vertex(20, planar_point(-3.75[m], -0.25[m]), "inner"),
