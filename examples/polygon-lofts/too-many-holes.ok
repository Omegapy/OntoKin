            }),
            "h7": polygon_ring(110, "hole", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(2.75[m], 0.25[m]), "inner"),
                "v1": polygon_vertex(10, planar_point(3.25[m], 0.25[m]), "inner"),
                "v2": polygon_vertex(20, planar_point(3.25[m], -0.25[m]), "inner"),
                "v3": polygon_vertex(30, planar_point(2.75[m], -0.25[m]), "inner")
            }),
            "h8": polygon_ring(120, "hole", keyed<PolygonVertex> {
