ontokin "0.10";
module RingLoftCase @ "ring-loft-case";
profile "polygon-loft-0.1";

public class Shape @ "shape" {
    public param sections @ "sections": Keyed<PolygonSection> = keyed<PolygonSection> {
        "s0": polygon_section(10, 0[m], keyed<PolygonRing> {
            "outer": polygon_ring(20, "outer", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(-2[m], -2[m]), "outer"),
                "v1": polygon_vertex(10, planar_point(2[m], -2[m]), "outer"),
                "v2": polygon_vertex(20, planar_point(2[m], 2[m]), "outer"),
                "v3": polygon_vertex(30, planar_point(-2[m], 2[m]), "outer")
            })
        }),
        "s1": polygon_section(20, 3[m], keyed<PolygonRing> {
            "outer": polygon_ring(20, "outer", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(-2[m], -2[m]), "outer"),
                "v1": polygon_vertex(10, planar_point(2[m], -2[m]), "outer"),
                "v2": polygon_vertex(20, planar_point(2[m], 2[m]), "outer"),
                "v3": polygon_vertex(30, planar_point(-2[m], 2[m]), "outer")
            })
        })
    };
    public param palette @ "palette": Keyed<SurfaceMaterial> = keyed<SurfaceMaterial> {

    };
    geometry = loft_rings(self.sections, self.palette, "bottom", "top");
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": Shape {
        placement = pose(world, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(shape, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
