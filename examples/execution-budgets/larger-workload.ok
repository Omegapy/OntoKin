ontokin "0.7";
module ForceWorkshop @ "force-workshop";
profile "planar-reach-budget-0.1";

execution { max_operations = 400000; max_elapsed = 80[s]; }

public class Vessel @ "vessel" {
    public param rings @ "rings": Keyed<LoftSection> = keyed<LoftSection> {
        "foot": loft_section(0[m], vec3(0[m], 0[m], 0[m]), 0.5[m], 0.35[m], "clay"),
        "neck": loft_section(1[m], vec3(0.15[m], 0[m], 0[m]), 0.3[m], 0.2[m], "paint"),
        "tip": loft_section(1.5[m], vec3(0.15[m], 0[m], 0[m]), 0.2[m], 0.1[m], "paint")
    };
    public param palette @ "palette": Keyed<SurfaceMaterial> = keyed<SurfaceMaterial> {
        "clay": surface_material(rgba(0.6, 0.3, 0.2, 1), 0, 0.8),
        "paint": surface_material(rgba(0.1, 0.4, 0.8, 1), 0.2, 0.4)
    };
    geometry = placed(loft(self.rings, self.palette, 16, "flat"),
        pose(self.frame, vec3(0[m], 0[m], 0.1[m]), quat(1, 0, 0, 0)));
    physical = sphere_body(0.5[m], 2[kg]);
    motion = dynamic;
    collision = disabled;
}

scene Workshop @ "workshop" {
    duration = 3[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object vessel1 @ "vessel-1": Vessel {
        placement = pose(world, vec3(-5[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    object vessel2 @ "vessel-2": Vessel {
        placement = pose(world, vec3(-3[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    object vessel3 @ "vessel-3": Vessel {
        placement = pose(world, vec3(-1[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    object vessel4 @ "vessel-4": Vessel {
        placement = pose(world, vec3(1[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    object vessel5 @ "vessel-5": Vessel {
        placement = pose(world, vec3(3[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    object vessel6 @ "vessel-6": Vessel {
        placement = pose(world, vec3(5[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    at 0[s] sequence {
        force vessel1 @ "lift-1" using vector(world, 0[N], 2[N], 0[N]) for 2[s];
        force vessel2 @ "lift-2" using vector(world, 0[N], 2[N], 0[N]) for 2[s];
        force vessel3 @ "lift-3" using vector(world, 0[N], 2[N], 0[N]) for 2[s];
        force vessel4 @ "lift-4" using vector(world, 0[N], 2[N], 0[N]) for 2[s];
        force vessel5 @ "lift-5" using vector(world, 0[N], 2[N], 0[N]) for 2[s];
        force vessel6 @ "lift-6" using vector(world, 0[N], 2[N], 0[N]) for 2[s];
    }
    at 1[s] sequence {
        impulse vessel1 using vector(world, 4[N*s], 0[N*s], 0[N*s]) at point(vessel1.frame, 0[m], 0[m], 0[m]);
        impulse vessel2 using vector(world, 4[N*s], 0[N*s], 0[N*s]) at point(vessel2.frame, 0[m], 0[m], 0[m]);
        impulse vessel3 using vector(world, 4[N*s], 0[N*s], 0[N*s]) at point(vessel3.frame, 0[m], 0[m], 0[m]);
        impulse vessel4 using vector(world, 4[N*s], 0[N*s], 0[N*s]) at point(vessel4.frame, 0[m], 0[m], 0[m]);
        impulse vessel5 using vector(world, 4[N*s], 0[N*s], 0[N*s]) at point(vessel5.frame, 0[m], 0[m], 0[m]);
        impulse vessel6 using vector(world, 4[N*s], 0[N*s], 0[N*s]) at point(vessel6.frame, 0[m], 0[m], 0[m]);
    }
}
