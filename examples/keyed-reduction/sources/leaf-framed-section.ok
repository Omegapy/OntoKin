ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": FramedPolygonSection = reduce_keyed<FramedPolygonSection>(keyed<FramedPolygonSection>{"kept": framed_polygon_section(0, pose(self.frame, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0)), keyed<PolygonRing>{"outer": polygon_ring(0, "outer", keyed<PolygonVertex>{"a": polygon_vertex(0, planar_point(0[m], 0[m]), "side"), "b": polygon_vertex(1, planar_point(1[m], 0[m]), "side"), "c": polygon_vertex(2, planar_point(0[m], 1[m]), "side")})})}, framed_polygon_section(0, pose(self.frame, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0)), keyed<PolygonRing>{"outer": polygon_ring(0, "outer", keyed<PolygonVertex>{"a": polygon_vertex(0, planar_point(0[m], 0[m]), "side"), "b": polygon_vertex(1, planar_point(1[m], 0[m]), "side"), "c": polygon_vertex(2, planar_point(0[m], 1[m]), "side")})}), (acc, k, v) -> v);
    public derive forced @ "forced": Keyed<FramedPolygonSection> = keyed<FramedPolygonSection>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
