ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": PlanarPoint = reduce_keyed<PlanarPoint>(keyed<PlanarPoint>{"kept": planar_point(1[m], 2[m])}, planar_point(1[m], 2[m]), (acc, k, v) -> v);
    public derive forced @ "forced": Keyed<PlanarPoint> = keyed<PlanarPoint>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
