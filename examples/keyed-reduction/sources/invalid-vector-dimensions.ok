ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Vec3<Length> = reduce_keyed<Vec3<Length>>(keyed<Length>{"a": 1[m]}, vec3(0[m], 0[m], 0[m]), (acc, k, v) -> vec3(v, 1[s], v));
    public derive forced @ "forced": Keyed<Vec3<Length>> = keyed<Vec3<Length>>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
