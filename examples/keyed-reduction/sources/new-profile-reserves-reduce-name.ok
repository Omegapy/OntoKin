ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";
public fn reduce_keyed @ "old-name"(value: Length) -> Length { return value; }

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Length = 1[m];
    public derive forced @ "forced": Keyed<Length> = keyed<Length>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
