ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": LoftSection = reduce_keyed<LoftSection>(keyed<LoftSection>{"kept": loft_section(0[m], vec3(0[m], 0[m], 0[m]), 1[m], 1[m], "side")}, loft_section(0[m], vec3(0[m], 0[m], 0[m]), 1[m], 1[m], "side"), (acc, k, v) -> v);
    public derive forced @ "forced": Keyed<LoftSection> = keyed<LoftSection>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
