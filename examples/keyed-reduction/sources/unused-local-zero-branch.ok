ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";
public fn total @ "total"(zero_local: Int) -> Real { return reduce_keyed<Real>(keyed<Int>{"a": 2}, 3.0, (acc, k, v) -> if false then acc / zero_local else acc + real(v)); }

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Real = total(0);
    public derive forced @ "forced": Keyed<Real> = keyed<Real>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
