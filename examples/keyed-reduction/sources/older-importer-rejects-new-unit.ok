ontokin "0.14";
module Probe @ "probe";
profile "keyed-transform-0.1";
import helper @ "helper-import" from "fixture.new-helper" version "1.0.0" digest "sha256:0e6cc7a7a5988453023ccf695cee655a8e6536af60372dd5a882385e5bd97567";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Length = helper.total(keyed<Length>{"a": 0.25[m]});
    public derive forced @ "forced": Keyed<Length> = keyed<Length>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
