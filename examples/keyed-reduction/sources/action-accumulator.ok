ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Action = reduce_keyed<Action>(keyed<Length>{"a": 1[m]}, move(self, vector(world, 1[m/s], 0[m/s], 0[m/s]), 1[s]), (acc, k, v) -> acc);
    geometry = box(vec3(1[m], 1[m], 1[m]));
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
