ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": SurfaceMaterial = reduce_keyed<SurfaceMaterial>(keyed<SurfaceMaterial>{"kept": surface_material(rgba(0.25, 0.5, 0.75, 1), 0, 0.5)}, surface_material(rgba(0.25, 0.5, 0.75, 1), 0, 0.5), (acc, k, v) -> v);
    public derive forced @ "forced": Keyed<SurfaceMaterial> = keyed<SurfaceMaterial>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
