ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";

public class ProbeShape @ "probe-shape" {
    public param dependency @ "dependency": Length = 3[m];
    public derive result @ "result": Length = reduce_keyed<Length>(keyed<Length>{"a": 1[m]}, reduce_keyed<Length>(keyed<Length>{"inner": self.dependency}, 0[m], (prior, inner_key, inner_value) -> prior + inner_value), (acc, k, v) -> v);
    public derive forced @ "forced": Keyed<Length> = keyed<Length>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
