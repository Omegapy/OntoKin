ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";
import lib @ "lib-import" from "fixture.old-helper" version "1.0.0" digest "sha256:f31bd747207c1938ab35639ceff49e804a8680ca040e38c7ce2b663d43b01774";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Length = reduce_keyed<Length>(keyed<Length>{"a": 0.25[m]}, 0[m], (acc, k, v) -> acc + lib.twice(v));
    public derive forced @ "forced": Keyed<Length> = keyed<Length>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
