ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Int = reduce_keyed<Int>(keyed<Int>{"z": 5, "a": 3, "A": 2, "0": 1, "left.eye": 4}, 0, (acc, k, v) -> acc * 10 + v);
    public derive forced @ "forced": Keyed<Int> = keyed<Int>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
