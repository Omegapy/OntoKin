ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Point3 = reduce_keyed<Point3>(keyed<Point3>{"kept": point(world, 1[m], 2[m], 3[m])}, point(world, 1[m], 2[m], 3[m]), (acc, k, v) -> v);
    public derive forced @ "forced": Keyed<Point3> = keyed<Point3>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
