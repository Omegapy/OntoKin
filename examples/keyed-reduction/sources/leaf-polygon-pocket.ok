ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": PolygonPocket = reduce_keyed<PolygonPocket>(keyed<PolygonPocket>{"kept": polygon_pocket(0, keyed<PolygonVertex>{"a": polygon_vertex(0, planar_point(0[m], 0[m]), "side"), "b": polygon_vertex(1, planar_point(1[m], 0[m]), "side"), "c": polygon_vertex(2, planar_point(0[m], 1[m]), "side")}, 0.25[m], "floor")}, polygon_pocket(0, keyed<PolygonVertex>{"a": polygon_vertex(0, planar_point(0[m], 0[m]), "side"), "b": polygon_vertex(1, planar_point(1[m], 0[m]), "side"), "c": polygon_vertex(2, planar_point(0[m], 1[m]), "side")}, 0.25[m], "floor"), (acc, k, v) -> v);
    public derive forced @ "forced": Keyed<PolygonPocket> = keyed<PolygonPocket>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
