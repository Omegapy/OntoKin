ontokin "0.14";
module Probe @ "probe";
profile "keyed-transform-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": PlanarUV = planar_uv(vec3(0[m], 0[m], 0[m]), vec3(1[m^-1], 0[m^-1], 0[m^-1]), vec3(0[m^-1], 1[m^-1], 0[m^-1]), 0, 0);
    public derive forced @ "forced": Keyed<PlanarUV> = keyed<PlanarUV>{"result": self.result};
    geometry = if len(self.forced) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
