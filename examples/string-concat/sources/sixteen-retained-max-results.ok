ontokin "0.20";
module StringConcatProbe @ "string-concat-probe";
profile "string-concat-0.1";
execution { max_operations=400000; max_elapsed=80[s]; }


public class ProbeShape @ "probe-shape" {
    public param half @ "half": String = "";
    public param almost_half @ "almost-half": String = "";
    public derive result @ "result": Keyed<String> = map_keyed<String>(keyed<Int>{"k00":0,"k01":1,"k02":2,"k03":3,"k04":4,"k05":5,"k06":6,"k07":7,"k08":8,"k09":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15}, (k,v)->self.half + self.half);
    geometry = if len(self.result) >= 0 then box(vec3(1[m], 1[m], 1[m])) else box(vec3(1[m], 1[m], 1[m]));
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
