ontokin "0.19";
module StringConcatProbe @ "string-concat-probe";
profile "keyed-rekey-0.1";

public fn left_fail @ "left-fail"(left_denominator:Int)->String { return if 1 / left_denominator > 0 then "left" else "left"; }
public fn right_fail @ "right-fail"(right_denominator:Int)->String { return if 1 / right_denominator > 0 then "right" else "right"; }

public class ProbeShape @ "probe-shape" {
    public derive result @ "result": String = left_fail(0) + true;
    geometry = if self.result == self.result then box(vec3(1[m], 1[m], 1[m])) else box(vec3(1[m], 1[m], 1[m]));
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
