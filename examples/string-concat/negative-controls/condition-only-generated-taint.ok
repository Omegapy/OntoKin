ontokin "0.19";
module StringConcatProbe @ "string-concat-probe";
profile "keyed-rekey-0.1";

public class Leaf @ "leaf" { public param label @ "label": String = "leaf."; geometry = box(vec3(1[m],1[m],1[m])); physical = no_body(); }

public class ProbeShape @ "probe-shape" {
    public parts children @ "children": Leaf for (ck,cv) in self.result {}
    public derive result @ "result": Keyed<Int> = rekey_keyed<Int>(keyed<Int>{"a":1},(k,v)->if self.children["a"].label == "leaf." then k else k);
    geometry = if len(self.result) >= 0 then box(vec3(1[m], 1[m], 1[m])) else box(vec3(1[m], 1[m], 1[m]));
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
