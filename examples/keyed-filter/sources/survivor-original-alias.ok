ontokin "0.16";
module Probe @ "probe";
profile "keyed-filter-0.1";


public class ProbeShape @ "probe-shape" {
    public param original @ "original": Keyed<Int> = keyed<Int>{"a": 1, "b": 2};
    public derive result @ "result": Keyed<Int> = filter_keyed<Int>(self.original, (k, v) -> v >= 2);
    public derive forced @ "forced": Int = len(self.result);
    public derive untouched @ "untouched": Keyed<Int> = self.original;
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
