ontokin "0.16";
module Probe @ "probe";
profile "keyed-filter-0.1";

public fn select @ "select"(items: Keyed<Int>, threshold: Int) -> Keyed<Int> { return filter_keyed<Int>(items, (fk, fv) -> fv >= threshold); }

public class ProbeShape @ "probe-shape" {
    public param inputs @ "inputs": Keyed<Int> = keyed<Int>{"a": 1, "b": 2}; public param threshold @ "threshold": Int = 2; public derive earlier @ "earlier": Keyed<Int> = select(self.inputs, self.threshold);
    public derive result @ "result": Keyed<Int> = if len(self.earlier) == 1 then select(self.inputs, self.threshold) else keyed<Int>{};
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
