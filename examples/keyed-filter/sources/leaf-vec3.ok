ontokin "0.16";
module Probe @ "probe";
profile "keyed-filter-0.1";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Vec3<Length>> = filter_keyed<Vec3<Length>>(keyed<Vec3<Length>>{"drop": vec3(1[m], 2[m], 3[m]), "keep": vec3(1[m], 2[m], 3[m])}, (k, v) -> k == "keep");
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
