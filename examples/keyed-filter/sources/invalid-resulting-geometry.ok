ontokin "0.16";
module Probe @ "probe";
profile "keyed-filter-0.1";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<PolygonVertex> = filter_keyed<PolygonVertex>(keyed<PolygonVertex>{"a": polygon_vertex(0, planar_point(0[m], 0[m]), "side"), "b": polygon_vertex(1, planar_point(1[m], 0[m]), "side"), "c": polygon_vertex(2, planar_point(0[m], 1[m]), "side")}, (k, v) -> k != "c");
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = extrude(self.result, keyed<SurfaceMaterial>{"bottom": surface_material(rgba(1, 1, 1, 1), 0, 0.5), "side": surface_material(rgba(1, 1, 1, 1), 0, 0.5), "top": surface_material(rgba(1, 1, 1, 1), 0, 0.5)}, 1[m], "bottom", "top");
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
