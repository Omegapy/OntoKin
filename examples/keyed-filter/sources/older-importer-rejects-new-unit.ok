ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";
import lib @ "lib-import" from "fixture.select-helper" version "1.0.0" digest "sha256:7bbbade1961a968241da75e35f688c4a4dd33ad6beae236b91cedbd74e63f550";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Length> = lib.select(keyed<Length>{"a": 0.25[m], "b": 0.5[m]});
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
