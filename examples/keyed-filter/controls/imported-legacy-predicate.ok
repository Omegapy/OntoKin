ontokin "0.15";
module Probe @ "probe";
profile "keyed-reduction-0.1";
import lib @ "lib-import" from "fixture.legacy" version "1.0.0" digest "sha256:811fbd9058439e2d78f16fe06c345c13eaf6789d6b88d81cd57f52ecaf775355";


public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Length> = keyed<Length>{"b": 0.5[m]};
    public derive forced @ "forced": Int = len(self.result);
    
    geometry = if self.forced >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
