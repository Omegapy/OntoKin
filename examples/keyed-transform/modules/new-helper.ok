ontokin "0.14";
module NewHelper @ "new-helper";
profile "keyed-transform-0.1";
import lib @ "lib-import" from "fixture.old-helper" version "1.0.0" digest "sha256:a1fbf0d1a984b66765c7e17502be2c301128852ca4392fc48fd449166335f773";
public fn widths @ "widths"(input: Keyed<Length>) -> Keyed<Length> { return map_keyed<Length>(input, (k, v) -> lib.twice(v)); }
