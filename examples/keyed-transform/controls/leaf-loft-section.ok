ontokin "0.13";
module Probe @ "probe";
profile "textured-surfaces-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<LoftSection> = keyed<LoftSection> {"kept": loft_section(0[m], vec3(0[m], 0[m], 0[m]), 1[m], 1[m], "side")};
    geometry = if len(self.result) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
