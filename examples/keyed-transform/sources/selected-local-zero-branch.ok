ontokin "0.14";
module Probe @ "probe";
profile "keyed-transform-0.1";
public fn transform @ "transform"(zero_local: Int) -> Keyed<Real> { return map_keyed<Real>(keyed<Int> {"a": 2}, (k, v) -> if true then v / zero_local else real(v)); }

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Real> = transform(0);
    geometry = if len(self.result) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
