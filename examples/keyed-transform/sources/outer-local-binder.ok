ontokin "0.14";
module Probe @ "probe";
profile "keyed-transform-0.1";
public fn transform @ "transform"(v: Length) -> Keyed<Length> { return map_keyed<Length>(keyed<Length> {"a": 1[m]}, (k, v) -> v); }

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Length> = transform(1[m]);
    geometry = if len(self.result) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
