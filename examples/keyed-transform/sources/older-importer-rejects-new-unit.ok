ontokin "0.13";
module Probe @ "probe";
profile "textured-surfaces-0.1";
import helper @ "helper-import" from "fixture.new-helper" version "1.0.0" digest "sha256:dbb40851fc36fccaaa37e0873540f9eb36b44fc7344fde82bd5fb86ca8db65fe";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<Length> = helper.widths(keyed<Length> {"a": 0.25[m]});
    geometry = if len(self.result) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
