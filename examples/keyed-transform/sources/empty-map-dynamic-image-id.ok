ontokin "0.14";
module Probe @ "probe";
profile "keyed-transform-0.1";

public class ProbeShape @ "probe-shape" {
    
    public derive result @ "result": Keyed<TextureImage> = map_keyed<TextureImage>(keyed<Int>{}, (k, v) -> png_asset(k, "sha256:5f87c7071d06327a077e05e1f57253370bc0b2eff1fa7f2025765825b7dcdd6e"));
    geometry = if len(self.result) >= 0 then box(vec3(1[m], 1[m], 1[m])) else empty();
    physical = no_body();
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": ProbeShape {}
}
