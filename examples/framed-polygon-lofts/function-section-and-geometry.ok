ontokin "0.11";
module FramedLoftCase @ "framed-loft-case";
profile "framed-polygon-loft-0.1";

public fn make_section @ "make-section"(order: Int, frame: Pose, rings: Keyed<PolygonRing>) -> FramedPolygonSection {
    return framed_polygon_section(order, frame, rings);
}
public fn make_geometry @ "make-geometry"(sections: Keyed<FramedPolygonSection>, palette: Keyed<SurfaceMaterial>) -> Geometry {
    return loft_framed_rings(sections, palette, "bottom", "top");
}

public class Shape @ "shape" {
    public param sections @ "sections": Keyed<FramedPolygonSection> = keyed<FramedPolygonSection> {
        "s0": make_section(10, pose(self.frame, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0)), keyed<PolygonRing> {
            "outer": polygon_ring(20, "outer", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(-1[m], -1[m]), "outer"),
                "v1": polygon_vertex(10, planar_point(1[m], -1[m]), "outer"),
                "v2": polygon_vertex(20, planar_point(1[m], 1[m]), "outer"),
                "v3": polygon_vertex(30, planar_point(-1[m], 1[m]), "outer")
            })
        }),
        "s1": make_section(20, pose(self.frame, vec3(0[m], 0[m], 4[m]), quat(1, 0, 0, 0)), keyed<PolygonRing> {
            "outer": polygon_ring(20, "outer", keyed<PolygonVertex> {
                "v0": polygon_vertex(0, planar_point(-1[m], -1[m]), "outer"),
                "v1": polygon_vertex(10, planar_point(1[m], -1[m]), "outer"),
                "v2": polygon_vertex(20, planar_point(1[m], 1[m]), "outer"),
                "v3": polygon_vertex(30, planar_point(-1[m], 1[m]), "outer")
            })
        })
    };
    public param palette @ "palette": Keyed<SurfaceMaterial> = keyed<SurfaceMaterial> {
        "bottom": surface_material(rgba(0.3, 0.35, 0.4, 1), 0.1, 0.65),
        "inner": surface_material(rgba(0.15, 0.65, 0.3, 1), 0.1, 0.65),
        "outer": surface_material(rgba(0.7, 0.3, 0.1, 1), 0.1, 0.65),
        "top": surface_material(rgba(0.1, 0.5, 0.8, 1), 0.1, 0.65)
    };
    geometry = make_geometry(self.sections, self.palette);
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": Shape {
        placement = pose(world, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(shape, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
