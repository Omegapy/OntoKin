ontokin "0.11";
module FramedLoftParts @ "framed-loft-parts";
profile "framed-polygon-loft-0.1";

public class Shape @ "shape" {
    public param end_x @ "end-x": Length = 4[m];
    public param rise @ "rise": Length = 4[m];
    public param rings @ "rings": Keyed<PolygonRing> = keyed<PolygonRing> {
        "outer": polygon_ring(20, "outer", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(-1[m], -1[m]), "outer"),
            "v1": polygon_vertex(10, planar_point(1[m], -1[m]), "outer"),
            "v2": polygon_vertex(20, planar_point(1[m], 1[m]), "outer"),
            "v3": polygon_vertex(30, planar_point(-1[m], 1[m]), "outer")
        }),
        "opening": polygon_ring(40, "hole", keyed<PolygonVertex> {
            "v0": polygon_vertex(0, planar_point(-0.5[m], 0.5[m]), "inner"),
            "v1": polygon_vertex(10, planar_point(0.5[m], 0.5[m]), "inner"),
            "v2": polygon_vertex(20, planar_point(0.5[m], -0.5[m]), "inner"),
            "v3": polygon_vertex(30, planar_point(-0.5[m], -0.5[m]), "inner")
        })
    };
    public param palette @ "palette": Keyed<SurfaceMaterial> = keyed<SurfaceMaterial> {
        "bottom": surface_material(rgba(0.3, 0.35, 0.4, 1), 0.1, 0.65),
        "inner": surface_material(rgba(0.15, 0.65, 0.3, 1), 0.1, 0.65),
        "outer": surface_material(rgba(0.7, 0.3, 0.1, 1), 0.1, 0.65),
        "top": surface_material(rgba(0.1, 0.5, 0.8, 1), 0.1, 0.65)
    };
    geometry = loft_framed_rings(keyed<FramedPolygonSection> {
        "s0": framed_polygon_section(10, pose(self.frame, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0)), self.rings),
        "s1": framed_polygon_section(20, pose(self.frame, vec3(self.end_x, 0[m], self.rise), quat(0.7071067811865476, 0, 0.7071067811865476, 0)), self.rings)
    }, self.palette, "bottom", "top");
    physical = no_body();
}
