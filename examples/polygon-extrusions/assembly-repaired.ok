ontokin "0.8";
module ExtrusionAssembly @ "extrusion-assembly";
profile "polygon-extrusion-0.1";

import parts @ "extrusion-parts" from "fixture.extrusion-parts" version "1.0.0"
    digest "sha256:8b46402f2565f41385122355fa138e0442d0b9edd6e2e4616781cad90f3daa20";

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object first @ "first": parts.Shape {
        placement = pose(world, vec3(-2[m], 0[m], 0[m]), quat(1, 0, 0, 0));
        outline = keyed<PolygonVertex> {
        "v0": polygon_vertex(0, planar_point(0[m], 0[m]), "side"),
        "v1": polygon_vertex(10, planar_point(3[m], 0[m]), "side"),
        "v2": polygon_vertex(20, planar_point(3[m], 1[m]), "side"),
        "v3": polygon_vertex(30, planar_point(1.5[m], 1[m]), "side"),
        "v4": polygon_vertex(40, planar_point(1[m], 3[m]), "side"),
        "v5": polygon_vertex(50, planar_point(0[m], 3[m]), "side")
    };
    }
    object sibling @ "sibling": parts.Shape {
        placement = pose(world, vec3(2[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(first, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
