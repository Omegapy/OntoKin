ontokin "0.8";
module ExtrusionCase @ "extrusion-case";
profile "polygon-extrusion-0.1";

public class Shape @ "shape" {
    public param outline @ "outline": Keyed<PolygonVertex> = keyed<PolygonVertex> {
        "v0": polygon_vertex(0, planar_point(0[m], 0[m]), "side"),
        "v1": polygon_vertex(10, planar_point(2[m], 0[m]), "side"),
        "v2": polygon_vertex(20, planar_point(2[m], 1[m]), "side"),
        "v3": polygon_vertex(30, planar_point(0[m], 1[m]), "side")
    };
    public param depth @ "depth": Length = 0[m];
    public param palette @ "palette": Keyed<SurfaceMaterial> = keyed<SurfaceMaterial> {
        "bottom": surface_material(rgba(0.3, 0.35, 0.4, 1), 0.1, 0.65),
        "side": surface_material(rgba(0.7, 0.3, 0.1, 1), 0.1, 0.65),
        "top": surface_material(rgba(0.1, 0.5, 0.8, 1), 0.1, 0.65)
    };
    geometry = extrude(self.outline, self.palette, self.depth, "bottom", "top");
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object shape @ "shape": Shape {
        placement = pose(world, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(shape, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
