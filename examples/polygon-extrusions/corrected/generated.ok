ontokin "0.8";
module ExtrusionAssembly @ "extrusion-assembly";
profile "polygon-extrusion-0.1";

import libparts @ "extrusion-parts" from "fixture.extrusion-parts" version "1.0.0"
    digest "sha256:8b46402f2565f41385122355fa138e0442d0b9edd6e2e4616781cad90f3daa20";

public class Mounted @ "mounted" extends libparts.Shape {
    public param parent_frame @ "parent-frame": FrameRef = world;
    public param mount_x @ "mount-x": Length = 0[m];
    public follow mounting @ "mounting" {
        parent = self.parent_frame;
        child = self;
        offset = pose(self.parent_frame, vec3(self.mount_x, 0[m], 0[m]), quat(1, 0, 0, 0));
    }
}
public class Array @ "array-type" {
    public param depths @ "depths": Keyed<Length> = keyed<Length> {
        "left": 0.25[m], "middle": 0.5[m], "right": 0.75[m]
    };
    geometry = empty();
    physical = no_body();
    public parts brackets @ "brackets": Mounted for (key, value) in self.depths {
        parent_frame = self.frame;
        mount_x = 16 * value;
        depth = value;
    }
}
scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object array @ "array": Array {
        placement = pose(world, vec3(-8[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action travel @ "travel" = move(array, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence { start travel; }
}
