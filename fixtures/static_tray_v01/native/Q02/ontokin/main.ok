ontokin "0.2";
module EquipmentTray @ "equipment-tray";
profile "construction-0.1";
import trays @ "tray-library" from "ontokin.static-tray" version "0.1.0" digest "sha256:849f784ee51a84908f1921e92d8136fefad409627199f6df17f4c0cdf8cdfb34";
scene Pair @ "pair" {
 duration = 1[s];
 gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
 object left @ "left": trays.Tray {
  payload_width = 0.01[m];
  payload_height = 0.01[m];
  payload_depth = 0.01[m];
  clearance = 0.001[m];
  wall_thickness = 0.001[m];
  base_thickness = 0.001[m];
  headroom = 0.001[m];
  placement = pose(world, vec3(-10[m], -10[m], -10[m]), quat(1, 0, 0, 0));
 }
 object right @ "right": trays.Tray {
  payload_width = 1[m];
  payload_height = 0.5[m];
  payload_depth = 1[m];
  clearance = 0.05[m];
  wall_thickness = 0.025[m];
  base_thickness = 0.025[m];
  headroom = 0.1[m];
  placement = pose(world, vec3(10[m], 10[m], 10[m]), quat(1, 0, 0, 0));
 }
}
