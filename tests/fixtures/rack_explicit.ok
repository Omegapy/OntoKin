ontokin "0.1";
module ExplicitRackReference @ "explicit-rack-reference";
profile "core-0.1";

// Independently authored ordinary assembly for the adopted keyed Rack oracle.
// Each of the eight Fingers is a real part declaration; no generator/import.
class Blade @ "blade" {
    public param length @ "length": Length = 0.6[m];
    geometry = box(vec3(self.length, 0.08[m], 0.08[m]));
    appearance = rgba(0.2, 0.6, 0.9, 1);
    public site base @ "base" {
        pose = pose(self.frame, vec3(-self.length / 2, 0[m], 0[m]), quat(1, 0, 0, 0));
        interface = "hinged.part";
        size = 0[m];
    }
}

class Finger @ "finger" {
    public param parent_frame @ "parent-frame": FrameRef = world;
    public param mount_offset @ "mount-offset": Vec3<Length> = vec3(0[m], 0[m], 0[m]);
    public param length @ "length": Length = 0.6[m];
    geometry = sphere(0.06[m]);
    appearance = rgba(0.2, 0.6, 0.9, 1);
    public follow mounting @ "mounting" {
        parent = self.parent_frame;
        child = self;
        offset = pose(self.parent_frame, self.mount_offset, quat(1, 0, 0, 0));
    }
    public site pivot @ "pivot" {
        pose = pose(self.frame, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
        interface = "hinged.part";
        size = 0[m];
    }
    private part blade @ "blade": Blade { length = self.length; }
    public joint flex @ "flex": hinge {
        parent = self.pivot;
        child = self.blade.base;
        axis = vec3(0, 0, 1);
        limits = range(-45[deg], 45[deg]);
        initial = 0[rad];
    }
    public method bend_to @ "bend-to"(angle: Angle, duration: Time) -> Action {
        return tween(self.flex, angle, duration);
    }
}

class ThreeRack @ "three-rack" {
    geometry = box(vec3(0.1[m], 1.8[m], 0.1[m]));
    appearance = rgba(0.45, 0.45, 0.5, 1);
    public part lower @ "lower": Finger {
        parent_frame = self.frame;
        mount_offset = vec3(0[m], -0.6[m], 0[m]);
    }
    public part middle @ "middle": Finger {
        parent_frame = self.frame;
        mount_offset = vec3(0[m], 0[m], 0[m]);
    }
    public part upper @ "upper": Finger {
        parent_frame = self.frame;
        mount_offset = vec3(0[m], 0.6[m], 0[m]);
    }
}

class FiveRack @ "five-rack" {
    geometry = box(vec3(0.1[m], 3[m], 0.1[m]));
    appearance = rgba(0.45, 0.45, 0.5, 1);
    public part bottom @ "bottom": Finger {
        parent_frame = self.frame;
        mount_offset = vec3(0[m], -1.2[m], 0[m]);
    }
    public part lower @ "lower": Finger {
        parent_frame = self.frame;
        mount_offset = vec3(0[m], -0.6[m], 0[m]);
    }
    public part middle @ "middle": Finger {
        parent_frame = self.frame;
        mount_offset = vec3(0[m], 0[m], 0[m]);
    }
    public part upper @ "upper": Finger {
        parent_frame = self.frame;
        mount_offset = vec3(0[m], 0.6[m], 0[m]);
    }
    public part top @ "top": Finger {
        parent_frame = self.frame;
        mount_offset = vec3(0[m], 1.2[m], 0[m]);
    }
}

scene Demo @ "demo" {
    duration = 2[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object first @ "first": ThreeRack {
        placement = pose(world, vec3(-1[m], 0[m], 0[m]), quat(1, 0, 0, 0));
        middle.length = 0.75[m];
    }
    object second @ "second": FiveRack {
        placement = pose(world, vec3(1[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    action flex @ "flex" = first.middle.bend_to(45[deg], 1[s]);
    action travel @ "travel" = move(first, vector(world, 0[m/s], 0.2[m/s], 0[m/s]), 2[s]);
    at 0[s] sequence { start flex; start travel; }
}
