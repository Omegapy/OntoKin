ontokin "0.21";
module MembershipProbe @ "membership-probe";
profile "keyed-membership-0.1";

public class Probe @ "probe" {
    public derive observed @ "observed": Bool = has_key(keyed<PlanarUV>{"entry":planar_uv(vec3(0[m],0[m],0[m]),vec3(1[m^-1],0[m^-1],0[m^-1]),vec3(0[m^-1],1[m^-1],0[m^-1]),0,0)},"entry");
    geometry = box(vec3(if self.observed then 2[m] else 1[m], 1[m], 1[m]));
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object probe @ "probe": Probe {}
}
