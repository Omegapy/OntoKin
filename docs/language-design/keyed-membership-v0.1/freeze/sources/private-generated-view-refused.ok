ontokin "0.21";
module MembershipProbe @ "membership-probe";
profile "keyed-membership-0.1";

public class Child @ "child" {geometry=empty();physical=no_body();}
public class Owner @ "owner" {private parts children @ "children":Child for(k,v) in keyed<Int>{"a":1} {} geometry=empty();physical=no_body();}
public class Probe @ "probe" {
    public part owner @ "owner-part": Owner {}
    public derive observed @ "observed": Bool = has_key(self.owner.children,"a");
    geometry = box(vec3(if self.observed then 2[m] else 1[m],1[m],1[m]));
    physical = no_body();
}
scene Demo @ "demo" {
    duration=1[s];
    gravity=vector(world,0[m/s^2],0[m/s^2],0[m/s^2]);
    object probe @ "probe": Probe {}
}
