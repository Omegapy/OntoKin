ontokin "0.21";
module MembershipProbe @ "membership-probe";
profile "keyed-membership-0.1";

public class Child @ "child" { geometry=box(vec3(1[m],1[m],1[m])); physical=no_body(); }
public class Probe @ "probe" {
    public parts children @ "children": Child for (k,v) in keyed<Int>{} {}
    public derive observed @ "observed": Bool = has_key(self.children,"one");
    geometry = empty();
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object probe @ "probe": Probe {}
}
