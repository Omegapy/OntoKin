ontokin "0.21";
module MembershipProbe @ "membership-probe";
profile "keyed-membership-0.1";

public class Probe @ "probe" {
    public derive observed @ "observed": Bool = reduce_keyed<Bool>(keyed<String>{"q":"missing"},false,(found,k,v)->found or has_key(keyed<Length>{"a":1[m]},v));
    geometry=box(vec3(if self.observed then 2[m] else 1[m],1[m],1[m]));
    physical=no_body();
}
scene Demo @ "demo" {duration=1[s];gravity=vector(world,0[m/s^2],0[m/s^2],0[m/s^2]);object probe @ "probe": Probe {}}
