ontokin "0.20";
module SparsePanels @ "sparse-panels";
profile "string-concat-0.1";
import lib @ "lib-import" from "fixture.membership-panels" version "1.0.0" digest "sha256:3725a29fb9049dd425751fbe78999ddd447664ad468dca2b4c9416bf5b2757fb";

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world,0[m/s^2],0[m/s^2],0[m/s^2]);
    object first @ "first": lib.PanelGroup {
        placement = pose(world,vec3(-10[m],0[m],0[m]),quat(1,0,0,0));
        prefix = "front.";
        overrides = keyed<Length>{"left":0.75[m],"middle":2.25[m]};
        override_flags = keyed<Bool>{"left":true,"middle":true,"right":false};
    }
    object sibling @ "sibling": lib.PanelGroup {
        placement = pose(world,vec3(2[m],0[m],0[m]),quat(1,0,0,0));
        prefix = "back.";
        overrides = keyed<Length>{"right":1.75[m]};
        override_flags = keyed<Bool>{"left":false,"middle":false,"right":true};
    }
    object marker @ "marker": Object {
        placement = pose(world,vec3(0[m],-3[m],0[m]),quat(1,0,0,0));
        geometry = box(vec3(0.5[m],0.5[m],0.5[m]));
        physical = no_body();
    }
    action travel @ "travel" = move(first,vector(world,0[m/s],0.5[m/s],0[m/s]),1[s]);
    action marker_travel @ "marker-travel" = move(marker,vector(world,0.25[m/s],0[m/s],0[m/s]),1[s]);
    at 0[s] sequence { start travel; start marker_travel; }
}
