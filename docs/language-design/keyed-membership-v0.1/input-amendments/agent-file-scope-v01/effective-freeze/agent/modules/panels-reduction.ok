ontokin "0.20";
module Panels @ "membership-panels";
profile "string-concat-0.1";
import catalog @ "catalog-import" from "fixture.membership-catalog" version "1.0.0" digest "sha256:f9808d32ee2a99d8b57198553face12f95f75284971dbf38ba7ceb0935fc2dad";

public fn contains @ "contains"(values:Keyed<Length>,query:String)->Bool {
    return reduce_keyed<Bool>(values,false,(found,key,value)->found or key==query);
}

public class Panel @ "panel" {
    public param width @ "width": Length = 1[m];
    public param coat @ "coat": SurfaceMaterial = surface_material(rgba(0.25,0.5,0.75,1),0,0.7);
    public param parent_frame @ "parent-frame": FrameRef = world;
    public param mount_x @ "mount-x": Length = 0[m];
    public follow mounting @ "mounting" {
        parent = self.parent_frame;
        child = self;
        offset = pose(self.parent_frame, vec3(self.mount_x, 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    geometry = texture_surface(extrude(keyed<PolygonVertex> {
        "v0": polygon_vertex(0, planar_point(0[m], 0[m]), "side"),
        "v1": polygon_vertex(10, planar_point(self.width, 0[m]), "side"),
        "v2": polygon_vertex(20, planar_point(self.width, 2[m]), "side"),
        "v3": polygon_vertex(30, planar_point(0[m], 2[m]), "side")
    }, keyed<SurfaceMaterial> {
        "bottom": surface_material(rgba(1, 1, 1, 1), 0, 0.7),
        "side": self.coat,
        "top": surface_material(rgba(1, 1, 1, 1), 0, 0.7)
    }, 0.25[m], "bottom", "top"), keyed<TextureBinding> {
        "top": texture_binding(png_asset("label", "sha256:5f87c7071d06327a077e05e1f57253370bc0b2eff1fa7f2025765825b7dcdd6e"), planar_uv(vec3(0[m], 0[m], 0[m]),
            vec3(0.5[m^-1], 0[m^-1], 0[m^-1]), vec3(0[m^-1], -0.5[m^-1], 0[m^-1]), 0, 1))
    });
    physical = no_body();
}
public class PanelGroup @ "panel-group" {
    public param prefix @ "prefix": String = "front.";
    public param overrides @ "overrides": Keyed<Length> = keyed<Length>{};
    public param dimensions @ "dimensions": Keyed<Length> = catalog.defaults();
    public param mounts @ "mounts": Keyed<Length> = catalog.mounts();
    public param finishes @ "finishes": Keyed<SurfaceMaterial> = catalog.finishes();
    public derive original_names @ "original-names": Keyed<String> = map_keyed<String>(self.dimensions,(catalog_key,default_width)->catalog_key);
    public derive names @ "names": Keyed<String> = rekey_keyed<String>(self.original_names,(old_key,original_key)->self.prefix+old_key);
    public derive override_flags @ "override-flags": Keyed<Bool> = map_keyed<Bool>(self.dimensions,(catalog_key,default_width)->contains(self.overrides,catalog_key));
    public derive selected @ "selected": Keyed<Length> = map_keyed<Length>(self.dimensions,(catalog_key,default_width)->if contains(self.overrides,catalog_key) then self.overrides[catalog_key] else default_width);
    public parts panels @ "panels": Panel for (panel_key,original_key) in self.names {
        width = self.selected[original_key];
        coat = self.finishes[original_key];
        parent_frame = self.frame;
        mount_x = self.mounts[original_key];
    }
    geometry = empty();
    physical = no_body();
}
