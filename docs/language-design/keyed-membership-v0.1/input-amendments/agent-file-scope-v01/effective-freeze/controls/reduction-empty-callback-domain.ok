ontokin "0.20";
module MembershipProbe @ "membership-probe";
profile "string-concat-0.1";

public fn has_key @ "has-key-helper"(values: Keyed<Int>, query: String) -> Bool {
    return reduce_keyed<Bool>(values, false, (found, key, value) -> found or key == query);
}

public class Probe @ "probe" {
    public derive observed @ "observed": Bool = len(map_keyed<Bool>(keyed<Int>{},(k,v)->has_key(keyed<Int>{},"bad key")))==0;
    geometry = box(vec3(if self.observed then 2[m] else 1[m], 1[m], 1[m]));
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object probe @ "probe": Probe {}
}
