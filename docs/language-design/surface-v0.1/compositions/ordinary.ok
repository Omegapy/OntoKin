ontokin "0.3";
module SurfaceOrdinary @ "surface-ordinary";
profile "surface-0.1";

import shapes @ "surface-parts" from "fixture.surface-parts" version "1.0.0"
    digest "sha256:87fed50bdcb9b6274ec87981cc67028463c10b1cdce301060416c69586b428ce";

public class Pair @ "pair-type" {
    geometry = empty();
    physical = no_body();
    public part left @ "left": shapes.Shell {}
    public part right @ "right": shapes.Shell {
        rings = keyed<LoftSection> {
            "foot": loft_section(0[m], vec3(0[m], 0[m], 0[m]), 0.65[m], 0.4[m], "clay"),
            "middle": loft_section(0.7[m], vec3(0.2[m], 0[m], 0[m]), 0.48[m], 0.38[m], "clay"),
            "tip": loft_section(1.8[m], vec3(0.25[m], 0[m], 0[m]), 0.1[m], 0.1[m], "paint")
        };
    }
    public follow left_mount @ "left-mount" {
        parent = self.frame;
        child = self.left;
        offset = pose(self.frame, vec3(-0.8[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    public follow right_mount @ "right-mount" {
        parent = self.frame;
        child = self.right;
        offset = pose(self.frame, vec3(0.8[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
}

scene Demo @ "demo" {
    duration = 2[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object pair @ "pair": Pair {}
    action travel @ "travel" = move(pair, vector(world, 0.25[m/s], 0[m/s], 0[m/s]), 2[s]);
    at 0[s] sequence { start travel; }
}
