ontokin "0.3";
module SurfaceStudio @ "surface-studio";
profile "surface-0.1";

import shapes @ "surface-parts" from "fixture.surface-parts" version "1.0.0"
    digest "sha256:87fed50bdcb9b6274ec87981cc67028463c10b1cdce301060416c69586b428ce";

scene Studio @ "studio" {
    duration = 2[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object first @ "first": shapes.Shell {
        placement = pose(world, vec3(-2[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    object second @ "second": shapes.Shell {
        placement = pose(world, vec3(2[m], 0[m], 0[m]), quat(1, 0, 0, 0));
        rings = keyed<LoftSection> {
            "foot": loft_section(0[m], vec3(0[m], 0[m], 0[m]), 0.65[m], 0.4[m], "clay"),
            "middle": loft_section(0.7[m], vec3(0.2[m], 0[m], 0[m]), 0.48[m], 0.38[m], "clay"),
            "tip": loft_section(1.8[m], vec3(0.25[m], 0[m], 0[m]), 0.1[m], 0.1[m], "paint")
        };
    }
    action walk @ "walk" =
        move(first, vector(world, 0[m/s], 0.5[m/s], 0[m/s]), 2[s]);
    at 0[s] sequence {
        start walk;
    }
}
