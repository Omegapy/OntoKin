ontokin "0.2";
module Namespaces @ "namespaces";
profile "construction-0.1";

import left @ "left-import" from "example.left" version "1.0.0" digest "sha256:7d7ed2502ba88acfdc7d32668ae9bd0cf77add38f70cec5856c6c4a2e6a835b1";
import right @ "right-import" from "example.right" version "1.0.0" digest "sha256:8f822d2b66bdb32e88304f846f1667ce940573d271e5d08202f6b75197ce2c67";

fn sample @ "entry-sample"(value: Length) -> Length {
    return 99 * value;
}
fn left_value @ "left-value"(item: Ref<left.Marker>) -> Length {
    return item.base;
}
class Specialized @ "specialized" extends left.Marker {}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object a @ "a": left.Marker {
        base = 0.2[m];
        placement = pose(world, vec3(-1[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    object b @ "b": right.Marker {
        base = left_value(a);
        placement = pose(world, vec3(1[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
}
