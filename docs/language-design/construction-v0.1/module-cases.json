{
  "schema_version": "ontokin.construction-module-cases/0.1",
  "language_version": "0.2",
  "profile": "construction-0.1",
  "authority": "../OK-LANG-002-pinned-modules-and-keyed-assembly-construction.md",
  "expectation_basis": "Source bundles, diagnostic categories, identities, and arithmetic requirements are fixed inputs to the acceptance gate. This manifest records no observed pass status.",
  "settings": {
    "resolver": "explicit_supplied_closure_offline",
    "max_dependency_units": 16,
    "max_import_depth_edges": 8,
    "max_total_source_bytes": 2000000,
    "max_total_tokens": 200000,
    "default_requested_level": "constructed"
  },
  "ordering_rules": {
    "transport_before_candidate": "Malformed transport has no program identity or invented source span; a valid-shaped supplied manifest seals before parse or link.",
    "cycle_before_digest": "Linking validates the declared package/version graph for cycles before comparing exact content pins. The cyclic rejection fixture uses well-formed zero digests on its back edges, since cryptographic source-hash cycles cannot be authored as ordinary fixed points. This fixture must reject and never accepts any pinned content.",
    "revision_semantics": "The canonical manifest hashes every supplied source unit, its exact filename, package/version/source identity and raw UTF-8 content hash; module array ordering is excluded. A changed filename or invalid dependency therefore has an identity even before successful linking."
  },
