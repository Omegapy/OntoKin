{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontokin.org/schemas/force-v0.1/forces.schema.json",
  "title": "Complete source COM force projection, force-0.1",
  "description": "The same complete projection appears on every object. Explicit world quantities do not rotate in a self-frame query. A finite rational completion clock may exceed binary64 magnitude. JSON shape alone cannot establish source identity, positive duration, exact clock addition, sorted complete active sets, canonical sums, source-authorized edits or rollback. Those are mandatory independent checks.",
  "type": "object",
  "properties": {
    "active": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "net_force_world_n": {
      "$ref": "#/$defs/vector3"
    },
    "acceleration_world_m_per_s2": {
      "oneOf": [
        {
          "$ref": "#/$defs/vector3"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_count": {
      "type": "integer",
      "minimum": 0
    },
    "completed_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_change_time_seconds": {
      "oneOf": [
        {
          "$ref": "#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_changes": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/change"
      }
    }
  },
  "required": [
    "active",
    "net_force_world_n",
    "acceleration_world_m_per_s2",
    "started_count",
    "completed_count",
    "last_change_time_seconds",
    "last_changes"
  ],
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "source_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "start_byte",
        "end_byte"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stable_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "element_id": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "record": {
      "type": "object",
      "properties": {
        "force_key": {
          "$ref": "#/$defs/stable_key"
        },
        "force_element_id": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/stable_key"
            },
            {
              "$ref": "#/$defs/stable_key"
            },
            {
              "const": "force"
            },
            {
              "$ref": "#/$defs/stable_key"
            }
          ],
          "items": false
        },
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "target_element_id": {
          "$ref": "#/$defs/element_id"
        },
        "program_revision": {
          "$ref": "#/$defs/revision"
        },
        "source_location": {
          "$ref": "#/$defs/source_location"
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "force_world_n": {
          "$ref": "#/$defs/vector3"
        },
        "activation_time_seconds": {
          "$ref": "#/$defs/time"
        },
        "duration_seconds": {
          "$ref": "#/$defs/time"
        },
        "completion_time_seconds": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "force_key",
        "force_element_id",
        "target_path",
        "target_element_id",
        "program_revision",
        "source_location",
        "sequence_index",
        "force_world_n",
        "activation_time_seconds",
        "duration_seconds",
        "completion_time_seconds"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "force_key": {
          "$ref": "#/$defs/stable_key"
        },
        "force_element_id": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/stable_key"
            },
            {
              "$ref": "#/$defs/stable_key"
            },
            {
              "const": "force"
            },
            {
              "$ref": "#/$defs/stable_key"
            }
          ],
          "items": false
        },
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "target_element_id": {
          "$ref": "#/$defs/element_id"
        },
        "program_revision": {
          "$ref": "#/$defs/revision"
        },
        "source_location": {
          "$ref": "#/$defs/source_location"
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "force_world_n": {
          "$ref": "#/$defs/vector3"
        },
        "activation_time_seconds": {
          "$ref": "#/$defs/time"
        },
        "duration_seconds": {
          "$ref": "#/$defs/time"
        },
        "completion_time_seconds": {
          "$ref": "#/$defs/time"
        },
        "kind": {
          "enum": [
            "started",
            "completed"
          ]
        }
      },
      "required": [
        "force_key",
        "force_element_id",
        "target_path",
        "target_element_id",
        "program_revision",
        "source_location",
        "sequence_index",
        "force_world_n",
        "activation_time_seconds",
        "duration_seconds",
        "completion_time_seconds",
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "started_count": {
            "const": 0
          }
        },
        "required": [
          "started_count"
        ]
      },
      "then": {
        "properties": {
          "active": {
            "maxItems": 0
          },
          "completed_count": {
            "const": 0
          },
          "last_change_time_seconds": {
            "type": "null"
          },
          "last_changes": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "last_change_time_seconds": {
            "$ref": "#/$defs/time"
          },
          "last_changes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
