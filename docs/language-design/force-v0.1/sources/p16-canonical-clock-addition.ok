ontokin "0.5";
module ForceDemo @ "force-demo";
profile "force-0.1";

import bodies @ "impulse-parts" from "fixture.impulse-parts" version "1.0.0"
    digest "sha256:bc122164d828386ec970f8cf183ff22d57dcc90180fe84c574de84c575fc78d6";

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object ball @ "ball": bodies.SphereProp {
        body_mass = 2[kg];
        velocity = vector(world, 0[m/s], 0[m/s], 0[m/s]);
    }
    at 0.1[s] sequence {
        force ball @ "push" using vector(world, 4[N], 0[N], 0[N]) for 0.2[s];
    }
}
