ontokin "0.21";
module TorqueCases @ "torque-cases";
profile "keyed-membership-0.1";

import rotors @ "rotors" from "fixture.torque-carriers" version "1.0.0" digest "sha256:e0452a1de23724a65fe3ca50695e1cde138c138b291ec3b7acee850464e75e10";

public class Carrier @ "carrier-type" {
    geometry = empty();
    physical = no_body();
    public site tip @ "tip" {
        pose = pose(self.frame, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
        interface = "rigid.origin";
        size = 0[m];
    }
}

scene Demo @ "demo" {
    duration = 3[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object ball @ "ball": rotors.Rotor {
        motion = prescribed;
        body_mass = 2.5[kg];
        body_radius = 1[m];
        marker_radius = 1[m];
        velocity = vector(world, 0[m/s], 0[m/s], 0[m/s]);
        omega = vector(world, 0[rad/s], 0[rad/s], 0[rad/s]);
    }
    object sibling @ "sibling": rotors.Rotor {
        placement = pose(world, vec3(5[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    object carrier @ "carrier": Carrier {}
    joint hold @ "hold": grip { parent = carrier.tip; child = ball.origin; }
    action carry @ "carry" = move(carrier, vector(world, 1[m/s], 0[m/s], 0[m/s]), 1[s]);
    at 0[s] sequence {
        start carry;
    }
    at 1[s] sequence {
        release hold using incoming;
    }
}
