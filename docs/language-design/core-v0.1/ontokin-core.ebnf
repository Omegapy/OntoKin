(* OK-LANG-001 v0.1. Normative syntax; lexical terminals are defined in section 4. *)
program = "ontokin", STRING, ";", "module", IDENT, identity, ";",
          "profile", STRING, ";", { capability }, { definition }, scene ;
identity = "@", STRING ;
capability = "requires", STRING, ";" ;
definition = class_decl | function_decl ;
class_decl = "class", IDENT, identity, [ "extends", IDENT ], "{", { member }, "}" ;
member = property_decl | method_decl | part_decl | site_decl | joint_decl
       | follow_decl | assignment | override_default | assertion ;
visibility = "public" | "private" ;
property_decl = visibility, ( "param" | "derive" ), IDENT, identity, ":", type,
                "=", expression, ";" ;
override_default = "override", IDENT, "=", expression, ";" ;
method_decl = visibility, [ "override" ], "method", IDENT, identity, parameters,
              "->", type, function_body ;
function_decl = "fn", IDENT, identity, parameters, "->", type, function_body ;
parameters = "(", [ parameter, { ",", parameter } ], ")" ;
parameter = IDENT, ":", type ;
type = "Quantity", "[", unit_expr, "]"
     | IDENT, [ "<", type, { ",", type }, ">" ] ;
function_body = "{", { local_decl }, "return", expression, ";", "}" ;
local_decl = "let", IDENT, ":", type, "=", expression, ";" ;
part_decl = visibility, "part", IDENT, identity, ":", IDENT,
            "{", { assignment }, "}" ;
site_decl = visibility, "site", IDENT, identity, "{", { assignment }, "}" ;
joint_decl = [ visibility ], "joint", IDENT, identity, ":", IDENT,
             "{", { assignment }, "}" ;
follow_decl = [ visibility ], "follow", IDENT, identity, "{", { assignment }, "}" ;
scene = "scene", IDENT, identity, "{", { scene_member }, "}" ;
scene_member = assignment | object_decl | joint_decl | follow_decl
             | action_decl | event_block | assertion ;
object_decl = "object", IDENT, identity, ":", IDENT, "{", { assignment }, "}" ;
action_decl = "action", IDENT, identity, "=", expression, ";" ;
event_block = "at", expression, "sequence", "{", { event }, "}" ;
event = ( "start" | "pause" | "resume" | "stop" ), IDENT, ";"
      | "release", path, "using", "incoming", ";" ;
assignment = path, "=", expression, ";" ;
assertion = "assert", expression, ",", STRING, ";" ;
path = IDENT, { ".", IDENT } ;
expression = conditional ;
conditional = "if", expression, "then", expression, "else", expression | logical_or ;
logical_or = logical_and, { "or", logical_and } ;
logical_and = equality, { "and", equality } ;
equality = comparison, [ ( "==" | "!=" ), comparison ] ;
comparison = sum, [ ( "<" | "<=" | ">" | ">=" ), sum ] ;
sum = product, { ( "+" | "-" ), product } ;
product = unary, { ( "*" | "/" ), unary } ;
unary = ( "-" | "not" ), unary | postfix ;
postfix = primary, { ".", IDENT | "(", [ arguments ], ")" } ;
arguments = expression, { ",", expression } ;
primary = NUMBER, [ "[", unit_expr, "]" ] | STRING | "true" | "false" | IDENT
        | "(", expression, ")" ;
unit_expr = unit_factor, { ( "*" | "/" ), unit_factor } ;
unit_factor = IDENT, [ "^", [ "-" ], INTEGER ] ;
