{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ontokin.agent/0.4"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "enum": [
        "discover",
        "create",
        "edit",
        "validate",
        "inspect",
        "evaluate",
        "reset",
        "status",
        "cancel",
        "export",
        "artifact",
        "surface.mesh_page",
        null
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "rejected",
        "failed",
        "cancelled",
        "unknown_outcome"
      ]
    },
    "program_revision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "accepted_program_revision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_level": {
      "enum": [
        "represented",
        "constructed",
        "evaluated",
        "delivered",
        null
      ]
    },
    "achieved_level": {
      "enum": [
        "represented",
        "constructed",
        "evaluated",
        "delivered",
        null
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "https://omegapy.github.io/OntoKin/schemas/ontokin.diagnostic-0.2.json"
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "initial_state": {
          "$ref": "#/$defs/impulse_sample"
        },
        "run_state": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "last_valid_state": {
              "$ref": "#/$defs/impulse_sample"
            }
          }
        }
      }
    },
    "progress": {
      "type": [
        "object",
        "null"
      ]
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "protocol_error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "request_id",
    "operation",
    "status",
    "program_revision",
    "accepted_program_revision",
    "requested_level",
    "achieved_level",
    "run_id",
    "diagnostics",
    "result",
    "progress",
    "next_cursor",
    "truncated",
    "protocol_error"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omegapy.github.io/OntoKin/schemas/ontokin.agent-response-0.4.json",
  "title": "OntoKin source impulse program agent response 0.4",
  "description": "Inherits Agent/0.3 operations with explicit Agent/0.4, impulse-0.1 entry and GLB/0.4 delivery. No host impulse RPC. Nested surface capability contracts remain unchanged. Source, boundary, finite JSON, budget and transaction semantics are defined by OK-LANG-004 and OK-AGENT-004.",
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "element_id": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "stable_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion_wxyz": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "surface_summary": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "ontokin.surface-summary/0.1"
        },
        "profile": {
          "const": "surface-0.1"
        },
        "section_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable_key"
          },
          "maxItems": 64,
          "minItems": 2,
          "uniqueItems": true
        },
        "stations_m": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "maxItems": 64,
          "minItems": 2
        },
        "palette_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable_key"
          },
          "maxItems": 16,
          "minItems": 1,
          "uniqueItems": true
        },
        "facets": {
          "type": "integer",
          "minimum": 8,
          "maximum": 64,
          "multipleOf": 4
        },
        "caps": {
          "enum": [
            "flat",
            "none"
          ]
        },
        "triangle_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "vertex_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 24576,
          "multipleOf": 3
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "material_key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "triangle_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8192
              }
            },
            "required": [
              "key",
              "material_key",
              "triangle_count"
            ],
            "additionalProperties": false
          },
          "maxItems": 16,
          "minItems": 1
        },
        "local_visual_placement": {
          "type": "object",
          "properties": {
            "frame": {
              "const": "carrier_self_frame"
            },
            "position_m": {
              "$ref": "#/$defs/vector3"
            },
            "orientation_wxyz": {
              "$ref": "#/$defs/quaternion_wxyz"
            }
          },
          "required": [
            "frame",
            "position_m",
            "orientation_wxyz"
          ],
          "additionalProperties": false
        },
        "physical_participation": {
          "const": "none"
        },
        "motion_authority": {
          "const": "carrier_evaluated_world_pose"
        }
      },
      "required": [
        "schema_version",
        "profile",
        "section_keys",
        "stations_m",
        "palette_keys",
        "facets",
        "caps",
        "triangle_count",
        "vertex_count",
        "regions",
        "local_visual_placement",
        "physical_participation",
        "motion_authority"
      ],
      "additionalProperties": false
    },
    "mesh_page_result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "ontokin.surface-mesh-page/0.1"
        },
        "program_revision": {
          "$ref": "#/$defs/revision"
        },
        "element_id": {
          "$ref": "#/$defs/element_id"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "profile": {
          "const": "surface-0.1"
        },
        "geometry_sha256": {
          "$ref": "#/$defs/revision"
        },
        "coordinate_system": {
          "const": "carrier_local_after_placement/0.1"
        },
        "ordering": {
          "const": "native_triangle_ordinal/0.1"
        },
        "region": {
          "oneOf": [
            {
              "$ref": "#/$defs/stable_key"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_triangles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "filtered_triangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "returned_triangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "positions_m": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vector3"
          },
          "maxItems": 768
        },
        "normals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vector3"
          },
          "maxItems": 768
        },
        "triangles": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 767
            }
          },
          "maxItems": 256
        },
        "source_triangle_ordinals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8191
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "region_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable_key"
          },
          "maxItems": 256
        },
        "implementation": {
          "$ref": "#/$defs/implementation"
        }
      },
      "required": [
        "schema_version",
        "program_revision",
        "element_id",
        "path",
        "profile",
        "geometry_sha256",
        "coordinate_system",
        "ordering",
        "region",
        "total_triangles",
        "filtered_triangles",
        "offset",
        "returned_triangles",
        "positions_m",
        "normals",
        "triangles",
        "source_triangle_ordinals",
        "region_keys",
        "implementation"
      ],
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_code_sha256": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "name",
        "version",
        "source_code_sha256"
      ],
      "additionalProperties": false,
      "description": "Inherited durable service implementation identity. It identifies the loaded implementation, not a source program or output artifact."
    },
    "impulses": {
      "$ref": "https://ontokin.org/schemas/impulse-v0.1/impulses.schema.json"
    },
    "impulse_object_state": {
      "type": "object",
      "properties": {
        "impulses": {
          "$ref": "#/$defs/impulses"
        },
        "pose_authority": {
          "type": "object",
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "free_sphere"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "since_seconds": {
                    "type": "string",
                    "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
                  },
                  "trajectory_anchor_seconds": {
                    "type": "string",
                    "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
                  }
                },
                "required": [
                  "since_seconds",
                  "trajectory_anchor_seconds"
                ]
              }
            }
          ]
        }
      },
      "required": [
        "impulses",
        "pose_authority"
      ]
    },
    "impulse_sample": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "objects": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/impulse_object_state"
          }
        }
      },
      "required": [
        "objects"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "surface.mesh_page"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/mesh_page_result"
          },
          "requested_level": {
            "type": "null"
          },
          "achieved_level": {
            "const": "constructed"
          },
          "run_id": {
            "type": "null"
          },
          "program_revision": {
            "$ref": "#/$defs/revision"
          },
          "protocol_error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "inspect"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "geometry": {
                      "type": "object",
                      "properties": {
                        "surface": {
                          "$ref": "#/$defs/surface_summary"
                        }
                      }
                    },
                    "state": {
                      "type": "object",
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "available": {
                                "const": true
                              }
                            },
                            "required": [
                              "available"
                            ]
                          },
                          "then": {
                            "$ref": "#/$defs/impulse_object_state"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": "ontokin.surface-mesh-page/0.1"
              }
            },
            "required": [
              "schema_version"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "const": "surface.mesh_page"
          },
          "status": {
            "const": "succeeded"
          }
        }
      }
    }
  ]
}
