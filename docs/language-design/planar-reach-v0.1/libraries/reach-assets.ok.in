ontokin "0.6";
module ReachAssets @ "reach-assets";
profile "planar-reach-0.1";

import shapes @ "shapes" from "proposal.reach-exterior" version "0.1.0"
    digest "__EXTERIOR_DIGEST__";
import reach @ "reach" from "proposal.reach-parts" version "0.1.0"
    digest "__PARTS_DIGEST__";

public class BenchArm @ "bench-arm" {
    public param upper_length @ "upper-length": Length = 1[m];
    public param forearm_length @ "forearm-length": Length = 1[m];
    geometry = box(vec3(0.8[m], 0.25[m], 0.8[m]));
    appearance = rgba(0.18, 0.22, 0.26, 1);
    physical = no_body();
    public part column @ "column": shapes.Segment {
        length = 0.875[m];
        width = 0.12[m];
    }
    public follow column_mount @ "column-mount" {
        parent = self.frame;
        child = self.column;
        offset = pose(self.frame, vec3(0[m], 0.125[m], 0[m]), axis_angle(vec3(0, 0, 1), 90[deg]));
    }
    public part arm @ "arm": reach.PlanarArm {
        parent_frame = self.frame;
        mount_offset = vec3(0[m], 1[m], 0[m]);
        upper_length = self.upper_length;
        forearm_length = self.forearm_length;
    }
    public part tool @ "tool": shapes.Marker {
        radius = 0.12[m];
        tint = rgba(0.8, 0.65, 0.18, 1);
    }
    public follow tool_mount @ "tool-mount" {
        parent = self.arm.forearm.frame;
        child = self.tool;
        offset = pose(self.arm.forearm.frame, vec3(self.forearm_length, 0[m], 0[m]), quat(1, 0, 0, 0));
    }
}

public class Eye @ "eye" extends shapes.Marker {
    override radius = 0.05[m];
    override tint = rgba(0.04, 0.06, 0.08, 1);
    public param parent_frame @ "parent-frame": FrameRef = world;
    public param mount_offset @ "mount-offset": Vec3<Length> = vec3(0[m], 0[m], 0[m]);
    public follow mounting @ "mounting" {
        parent = self.parent_frame;
        child = self;
        offset = pose(self.parent_frame, self.mount_offset, quat(1, 0, 0, 0));
    }
}

public class Head @ "head" extends shapes.Marker {
    override radius = 0.25[m];
    override tint = rgba(0.75, 0.58, 0.36, 1);
    public param eye_offsets @ "eye-offsets": Keyed<Vec3<Length>> = keyed<Vec3<Length>> {
        "left": vec3(-0.1[m], 0.05[m], 0.23[m]),
        "right": vec3(0.1[m], 0.05[m], 0.23[m]),
        "brow": vec3(0[m], 0.16[m], 0.2[m])
    };
    public parts eyes @ "eyes": Eye for (key, offset) in self.eye_offsets {
        parent_frame = self.frame;
        mount_offset = offset;
    }
    public site base @ "base" {
        pose = pose(self.frame, vec3(0[m], -0.25[m], 0[m]), quat(1, 0, 0, 0));
        interface = "head.hinge";
        size = 0[m];
    }
}

public class SegmentedCharacter @ "segmented-character" {
    public param arm_offsets @ "arm-offsets": Keyed<Vec3<Length>> = keyed<Vec3<Length>> {
        "left": vec3(-0.35[m], 0.75[m], 0[m]),
        "right": vec3(0.35[m], 0.75[m], 0[m])
    };
    public param leg_offsets @ "leg-offsets": Keyed<Vec3<Length>> = keyed<Vec3<Length>> {
        "left": vec3(-0.3[m], 0[m], 0.12[m]),
        "middle": vec3(0[m], 0[m], -0.2[m]),
        "right": vec3(0.3[m], 0[m], 0.12[m])
    };
    public derive torso_sections @ "torso-sections": Keyed<LoftSection> = keyed<LoftSection> {
        "hip": loft_section(0[m], vec3(0[m], 0[m], 0[m]), 0.32[m], 0.2[m], "shell"),
        "chest": loft_section(0.6[m], vec3(0[m], 0[m], 0[m]), 0.4[m], 0.24[m], "trim"),
        "neck": loft_section(1[m], vec3(0[m], 0[m], 0[m]), 0.18[m], 0.16[m], "trim")
    };
    public derive palette @ "palette": Keyed<SurfaceMaterial> = keyed<SurfaceMaterial> {
        "shell": surface_material(rgba(0.25, 0.42, 0.62, 1), 0.1, 0.6),
        "trim": surface_material(rgba(0.72, 0.52, 0.3, 1), 0.15, 0.45)
    };
    geometry = placed(loft(self.torso_sections, self.palette, 16, "flat"),
        pose(self.frame, vec3(0[m], 0[m], 0[m]), axis_angle(vec3(1, 0, 0), -90[deg])));
    physical = no_body();
    public parts arms @ "arms": reach.PlanarArm for (key, offset) in self.arm_offsets {
        parent_frame = self.frame;
        mount_offset = offset;
        upper_length = 0.75[m];
        forearm_length = 0.5[m];
        width = 0.06[m];
    }
    public parts legs @ "legs": reach.PlanarArm for (key, offset) in self.leg_offsets {
        parent_frame = self.frame;
        mount_offset = offset;
        mount_rotation = axis_angle(vec3(0, 0, 1), -90[deg]);
        upper_length = 0.6[m];
        forearm_length = 0.5[m];
        width = 0.075[m];
    }
    public part head @ "head": Head {}
    public site neck @ "neck" {
        pose = pose(self.frame, vec3(0[m], 1[m], 0[m]), quat(1, 0, 0, 0));
        interface = "head.hinge";
        size = 0[m];
    }
    public joint look @ "look": hinge {
        parent = self.neck;
        child = self.head.base;
        axis = vec3(0, 1, 0);
        limits = range(-75[deg], 75[deg]);
        initial = 0[rad];
    }
    public method look_to @ "look-to"(angle: Angle, duration: Time) -> Action {
        return tween(self.look, angle, duration);
    }
}

public class ArmRack @ "arm-rack" {
    public param mounts @ "mounts": Keyed<Vec3<Length>> = keyed<Vec3<Length>> {
        "first": vec3(0[m], 0[m], 0[m])
    };
    geometry = box(vec3(0.15[m], 0.15[m] + real(len(self.mounts)) * 0.3[m], 0.15[m]));
    physical = no_body();
    public parts arms @ "arms": reach.PlanarArm for (key, offset) in self.mounts {
        parent_frame = self.frame;
        mount_offset = offset;
    }
}
