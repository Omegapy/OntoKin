(* OK-LANG-006 v0.1.0-draft.1: proposed additions, not an adopted parser grammar.
   Inherit the complete 0.5 grammar and lexical rules unchanged except the
   explicit source/profile pair below. Existing expression/call/type productions
   carry the new predefined names; no reach-specific statement production exists. *)

reach_program_header = 'ontokin', '"0.6"', ';',
                       module_declaration,
                       'profile', '"planar-reach-0.1"', ';' ;

(* Extend predefined type resolution in this profile only. *)
reach_branch_type = 'ReachBranch' ;
reach_branch_value = 'elbow_positive' | 'elbow_negative' ;

(* Signature checked by the type system, not separate call syntax. *)
reach_builder_call = 'reach_planar', '(', expression, ',', expression, ',',
                     expression, ',', expression, ',', expression, ',',
                     expression, ')' ;
(* Arguments: shoulder JointRef, elbow JointRef, tip SiteRef,
   target Point3, duration Time, branch ReachBranch. Result: Action.
   The ordinary expression grammar permits variables, pure calls, module aliases,
   self members and literal-key paths. The type checker rejects wrong arity/type.
   Do not introduce string/int to ReachBranch conversion or implicit frame casts. *)
