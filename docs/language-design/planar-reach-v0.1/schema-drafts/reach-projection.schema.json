{
  "$comment": "Proposed OK-LANG-006 0.1.0-draft.2; no adoption or implementation claim.",
  "$id": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/reach-projection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "context_origin": {
            "const": "agent"
          }
        },
        "required": [
          "context_origin"
        ]
      },
      "then": {
        "properties": {
          "candidate_only": {
            "type": "boolean"
          },
          "current": {
            "properties": {
              "value": {
                "properties": {
                  "observation": {
                    "properties": {
                      "context_kind": {
                        "enum": [
                          "run_sample",
                          "constructed_initial"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidate_only": {
            "const": false
          },
          "context_origin": {
            "const": "agent"
          }
        },
        "required": [
          "context_origin",
          "candidate_only"
        ]
      },
      "then": {
        "properties": {
          "accepted_program_revision": {
            "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/revision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "context_origin": {
            "const": "source_recording"
          }
        },
        "required": [
          "context_origin"
        ]
      },
      "then": {
        "properties": {
          "accepted_program_revision": {
            "type": "null"
          },
          "candidate_only": {
            "type": "null"
          },
          "current": {
            "properties": {
              "available": {
                "const": true
              },
              "value": {
                "properties": {
                  "observation": {
                    "properties": {
                      "context_kind": {
                        "const": "recorded_prefix"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "description": "One inspect actions[] record or snapshot reaches[path] record. Unrun inspection is unavailable rather than fabricated pending state. A sampled pending state has null admission fields. Failed admission is a diagnostic on the failed boundary; accepted projection is unchanged.",
  "properties": {
    "accepted_program_revision": {
      "oneOf": [
        {
          "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "enum": [
        "elbow_positive",
        "elbow_negative"
      ]
    },
    "candidate_only": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "chain": {
      "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/chain"
    },
    "channel": {
      "const": "joint_coordinates"
    },
    "context_origin": {
      "enum": [
        "agent",
        "source_recording"
      ]
    },
    "current": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "available": {
              "const": false
            },
            "reason": {
              "const": "run_required"
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "available",
            "reason",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "available": {
              "const": true
            },
            "reason": {
              "type": "null"
            },
            "value": {
              "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/reach_state"
            }
          },
          "required": [
            "available",
            "reason",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "description_identity": {
      "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/element_id"
    },
    "duration_seconds": {
      "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/time"
    },
    "element_id": {
      "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/element_id"
    },
    "kind": {
      "const": "reach_planar"
    },
    "program_revision": {
      "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/revision"
    },
    "source_location": {
      "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/source_location"
    },
    "target": {
      "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/target"
    }
  },
  "required": [
    "kind",
    "element_id",
    "description_identity",
    "program_revision",
    "accepted_program_revision",
    "candidate_only",
    "context_origin",
    "source_location",
    "channel",
    "chain",
    "target",
    "branch",
    "duration_seconds",
    "current"
  ],
  "title": "Proposed complete source-bound reach action projection",
  "type": "object"
}
