{
  "$comment": "Proposed OK-LANG-006 0.1.0-draft.2; no adoption or implementation claim.",
  "$id": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/glb-metadata.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Applies to document.extras.ontokin under the inherited exporter layout. This schema constrains the new reach additions and complete boundary projections. All other inherited source, surface/PBR, force, impulse, authority, geometry and active-scene rules still require their existing independent byte validators; unconstrained inherited fields are not exemptions.",
  "properties": {
    "boundary_states": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action_states_after": {
            "maxProperties": 100000,
            "type": "object"
          },
          "action_states_before": {
            "maxProperties": 100000,
            "type": "object"
          },
          "force_states_after": {
            "additionalProperties": {
              "$ref": "https://ontokin.org/schemas/force-v0.1/forces.schema.json"
            },
            "maxProperties": 1000,
            "type": "object"
          },
          "force_states_before": {
            "additionalProperties": {
              "$ref": "https://ontokin.org/schemas/force-v0.1/forces.schema.json"
            },
            "maxProperties": 1000,
            "type": "object"
          },
          "impulse_states_after": {
            "additionalProperties": {
              "$ref": "https://ontokin.org/schemas/impulse-v0.1/impulses.schema.json"
            },
            "maxProperties": 1000,
            "type": "object"
          },
          "impulse_states_before": {
            "additionalProperties": {
              "$ref": "https://ontokin.org/schemas/impulse-v0.1/impulses.schema.json"
            },
            "maxProperties": 1000,
            "type": "object"
          },
          "incoming_releases": {
            "items": {
              "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/incoming_release"
            },
            "maxItems": 100000,
            "minItems": 0,
            "type": "array"
          },
          "joint_states_after": {
            "maxProperties": 100000,
            "type": "object"
          },
          "joint_states_before": {
            "maxProperties": 100000,
            "type": "object"
          },
          "pose_authorities_after": {
            "maxProperties": 1000,
            "type": "object"
          },
          "pose_authorities_before": {
            "maxProperties": 1000,
            "type": "object"
          },
          "reach_states_after": {
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/reach-projection.schema.json"
                },
                {
                  "properties": {
                    "context_origin": {
                      "const": "source_recording"
                    },
                    "current": {
                      "properties": {
                        "available": {
                          "const": true
                        },
                        "value": {
                          "properties": {
                            "observation": {
                              "properties": {
                                "context_kind": {
                                  "const": "recorded_prefix"
                                },
                                "run_id": {
                                  "type": "null"
                                },
                                "side": {
                                  "const": "after"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "maxProperties": 128,
            "type": "object"
          },
          "reach_states_before": {
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/reach-projection.schema.json"
                },
                {
                  "properties": {
                    "context_origin": {
                      "const": "source_recording"
                    },
                    "current": {
                      "properties": {
                        "available": {
                          "const": true
                        },
                        "value": {
                          "properties": {
                            "observation": {
                              "properties": {
                                "context_kind": {
                                  "const": "recorded_prefix"
                                },
                                "run_id": {
                                  "type": "null"
                                },
                                "side": {
                                  "const": "before"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "maxProperties": 128,
            "type": "object"
          },
          "source_seconds": {
            "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/time"
          }
        },
        "required": [
          "source_seconds",
          "joint_states_before",
          "action_states_before",
          "pose_authorities_before",
          "impulse_states_before",
          "force_states_before",
          "reach_states_before",
          "joint_states_after",
          "action_states_after",
          "pose_authorities_after",
          "impulse_states_after",
          "force_states_after",
          "reach_states_after",
          "incoming_releases"
        ],
        "type": "object"
      },
      "maxItems": 100000,
      "minItems": 0,
      "type": "array"
    },
    "profile": {
      "const": "planar-reach-0.1"
    },
    "program": {
      "properties": {
        "manifest": {
          "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/source_manifest"
        },
        "revision": {
          "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/common.schema.json#/$defs/revision"
        }
      },
      "required": [
        "revision",
        "manifest"
      ],
      "type": "object"
    },
    "reach_profile": {
      "additionalProperties": false,
      "properties": {
        "bound_chain_tuple_max": {
          "const": 32
        },
        "goal_residual_max_m": {
          "const": 1e-09
        },
        "live_solver_embedded": {
          "const": false
        },
        "motion_model": {
          "const": "two_prescribed_planar_hinges"
        },
        "named_reach_action_max": {
          "const": 128
        },
        "rotation_interpolation": {
          "const": "shortest_arc_slerp"
        },
        "schema_version": {
          "const": "ontokin.reach-recording/0.1"
        },
        "source_profile": {
          "const": "planar-reach-0.1"
        }
      },
      "required": [
        "schema_version",
        "source_profile",
        "motion_model",
        "rotation_interpolation",
        "goal_residual_max_m",
        "bound_chain_tuple_max",
        "named_reach_action_max",
        "live_solver_embedded"
      ],
      "type": "object"
    },
    "reach_quantization": {
      "$ref": "https://omegapy.github.io/OntoKin/proposals/planar-reach-v0.1/quantization.schema.json"
    },
    "schema_version": {
      "const": "0.6"
    },
    "target_contract": {
      "const": "ontokin.glb/0.6"
    },
    "transform_policy": {
      "const": "all_nodes_are_roots_with_baked_world_poses"
    }
  },
  "required": [
    "target_contract",
    "schema_version",
    "profile",
    "transform_policy",
    "program",
    "reach_profile",
    "boundary_states",
    "reach_quantization"
  ],
  "title": "Proposed GLB0.6 metadata additions and complete boundary records",
  "type": "object"
}
