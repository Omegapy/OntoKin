ontokin "0.4";
module ImpulseDemo @ "impulse-demo";
profile "impulse-0.1";

import bodies @ "impulse-parts" from "fixture.impulse-parts" version "1.0.0"
    digest "sha256:bc122164d828386ec970f8cf183ff22d57dcc90180fe84c574de84c575fc78d6";

public class Rack @ "rack-class" {
    public param masses @ "masses": Keyed<Mass> = keyed<Mass> { "first": 2[kg], "second": 4[kg] };
    public param radii @ "radii": Keyed<Length> = keyed<Length> { "first": 0.5[m], "second": 0.5[m] };
    public parts props @ "props": bodies.SphereProp for (key, mass) in self.masses {
        body_mass = mass;
        body_radius = self.radii[key];
        placement = pose(world, vec3(if key == "first" then 0[m] else 3[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
}

scene Demo @ "demo" {
    duration = 2[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object rack @ "rack": Rack {
        masses = keyed<Mass> { "first": 4[kg], "second": 4[kg] };
        radii = keyed<Length> { "first": 0.5[m], "second": 0.5[m] };
    }
    at 1[s] sequence {
        impulse rack.props["first"] using vector(world, 0[N*s], 2[N*s], 0[N*s]) at point(rack.props["first"].frame, 0.5[m], 0[m], 0[m]);
        impulse rack.props["second"] using vector(world, 0[N*s], 2[N*s], 0[N*s]) at point(rack.props["second"].frame, 0.5[m], 0[m], 0[m]);
    }
}
