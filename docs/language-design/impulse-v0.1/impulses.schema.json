{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontokin.org/schemas/impulse-v0.1/impulses.schema.json",
  "title": "Proposed impulse-0.1 object state.impulses",
  "description": "Proposed before implementation. Cross-field latest-boundary, finite-number, source-span and complete-output-budget rules are normative in OK-LANG-004. No full-history log or silent truncation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applied_count",
    "last_application_time_seconds",
    "last_applications"
  ],
  "properties": {
    "applied_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_application_time_seconds": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "last_applications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/application"
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "source_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "start_byte",
        "end_byte"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence_index",
        "source_location",
        "target_element_id",
        "target_path",
        "impulse_world_n_s",
        "application_point_self_m",
        "lever_arm_world_m",
        "application_point_world_m",
        "angular_impulse_world_n_m_s",
        "linear_velocity_before_world_m_per_s",
        "linear_velocity_after_world_m_per_s",
        "angular_velocity_before_world_rad_per_s",
        "angular_velocity_after_world_rad_per_s"
      ],
      "properties": {
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_location": {
          "$ref": "#/$defs/source_location"
        },
        "target_element_id": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "impulse_world_n_s": {
          "$ref": "#/$defs/vector3"
        },
        "application_point_self_m": {
          "$ref": "#/$defs/vector3"
        },
        "lever_arm_world_m": {
          "$ref": "#/$defs/vector3"
        },
        "application_point_world_m": {
          "$ref": "#/$defs/vector3"
        },
        "angular_impulse_world_n_m_s": {
          "$ref": "#/$defs/vector3"
        },
        "linear_velocity_before_world_m_per_s": {
          "$ref": "#/$defs/vector3"
        },
        "linear_velocity_after_world_m_per_s": {
          "$ref": "#/$defs/vector3"
        },
        "angular_velocity_before_world_rad_per_s": {
          "$ref": "#/$defs/vector3"
        },
        "angular_velocity_after_world_rad_per_s": {
          "$ref": "#/$defs/vector3"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applied_count": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "last_application_time_seconds": {
            "type": "null"
          },
          "last_applications": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "last_application_time_seconds": {
            "type": "string"
          },
          "last_applications": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
