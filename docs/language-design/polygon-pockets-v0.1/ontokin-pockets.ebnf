(* OK-LANG-012/0.1.0 -- explicit C079 blind polygon pocket supplement.
   Inherit the complete .11 expression, declaration, keyed-value and lexical
   grammar and the .7 entry-only execution header, under these explicit new
   source/profile selectors. Earlier declaring modules retain their grammar.
   New constructors use ordinary calls and static type checking; these named
   productions document signatures rather than introducing new statements. *)

pockets_program_header = 'ontokin', '"0.12"', ';',
                         module_declaration,
                         'profile', '"polygon-pockets-0.1"', ';' ;

pockets_predefined_type = 'PolygonPocket' ;

polygon_pocket_call = 'polygon_pocket', '(', expression, ',', expression, ',',
                      expression, ',', expression, ')' ;
(* Int order, Keyed<PolygonVertex> vertices, Length depth, String floor_region
   -> PolygonPocket. The enclosing keyed entry supplies the pocket key. *)

extrude_pockets_call = 'extrude_pockets', '(', expression, ',', expression, ',',
                      expression, ',', expression, ',', expression, ',',
                      expression, ')' ;
(* Keyed<PolygonVertex> outer_vertices, Keyed<PolygonPocket> pockets,
   Keyed<SurfaceMaterial> palette, Length height, String bottom_region,
   String top_region -> Geometry. An empty typed keyed pocket value is valid. *)

(* Existing planar_point, polygon_vertex, surface_material and placed calls
   retain their signatures. Wrong arity/type uses OKL-E-TYPE; dimension errors
   keep the existing unit diagnostic. Names are available only in an explicitly
   selected .12 declaring module. Pinned earlier definitions remain governed by
   their own source profile. Semantic ordering, bounds, winding, floor arithmetic
   and material ownership are fixed by ADOPTION.md, not by this syntax grammar. *)
