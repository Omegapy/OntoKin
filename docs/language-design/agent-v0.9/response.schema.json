                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "since_seconds": {
                    "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
                    "type": "string"
                  },
                  "trajectory_anchor_seconds": {
                    "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
                    "type": "string"
                  }
                },
                "required": [
                  "since_seconds",
                  "trajectory_anchor_seconds"
                ]
              }
            }
          ],
          "type": "object"
        }
      },
      "required": [
        "impulses",
        "pose_authority",
        "forces"
      ],
      "type": "object"
    },
