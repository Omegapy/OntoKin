{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ontokin.diagnostic/0.2"
    },
    "program_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_revision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "error",
        "warning"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "seconds": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
              "maxLength": 1024
            },
            "side": {
              "enum": [
                "before",
                "after"
              ]
            }
          },
          "required": [
            "seconds",
            "side"
          ],
          "additionalProperties": false
        }
      ]
    },
    "primary": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "source_revision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "start_byte": {
              "type": "integer",
              "minimum": 0
            },
            "end_byte": {
              "type": "integer",
              "minimum": 0
            },
            "element_id": {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "source_id",
            "source_revision",
            "file",
            "start_byte",
            "end_byte",
            "element_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "end_byte": {
            "type": "integer",
            "minimum": 0
          },
          "element_id": {
            "oneOf": [
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source_id",
          "source_revision",
          "file",
          "start_byte",
          "end_byte",
          "element_id"
        ],
        "additionalProperties": false
      }
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "details": {
      "type": "object"
    },
    "repair": {
      "type": [
        "object",
        "null"
      ]
    },
    "blocks": {
      "type": "array",
      "items": {
        "enum": [
          "represented",
          "constructed",
          "evaluated",
          "delivered"
        ]
      }
    },
    "location_status": {
      "const": "program_condition_without_source_span"
    }
  },
  "required": [
    "schema_version",
    "program_revision",
    "source_id",
    "source_revision",
    "run_id",
    "code",
    "severity",
    "category",
    "phase",
    "message",
    "time",
    "primary",
    "related",
    "rule_ids",
    "details",
    "repair",
    "blocks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omegapy.github.io/OntoKin/schemas/ontokin.diagnostic-0.2.json"
}
