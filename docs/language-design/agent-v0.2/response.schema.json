{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ontokin.agent/0.2"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "enum": [
        "discover",
        "create",
        "edit",
        "validate",
        "inspect",
        "evaluate",
        "reset",
        "status",
        "cancel",
        "export",
        "artifact",
        null
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "rejected",
        "failed",
        "cancelled",
        "unknown_outcome"
      ]
    },
    "program_revision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "accepted_program_revision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_level": {
      "enum": [
        "represented",
        "constructed",
        "evaluated",
        "delivered",
        null
      ]
    },
    "achieved_level": {
      "enum": [
        "represented",
        "constructed",
        "evaluated",
        "delivered",
        null
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "https://omegapy.github.io/OntoKin/schemas/ontokin.diagnostic-0.2.json"
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "progress": {
      "type": [
        "object",
        "null"
      ]
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "protocol_error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "request_id",
    "operation",
    "status",
    "program_revision",
    "accepted_program_revision",
    "requested_level",
    "achieved_level",
    "run_id",
    "diagnostics",
    "result",
    "progress",
    "next_cursor",
    "truncated",
    "protocol_error"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omegapy.github.io/OntoKin/schemas/ontokin.agent-response-0.2.json",
  "title": "OntoKin program agent envelope0.2"
}
