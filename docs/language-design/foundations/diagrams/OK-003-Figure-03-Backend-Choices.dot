digraph options {
 graph [rankdir=TB, bgcolor="white", pad="0.30", nodesep="0.42", ranksep="0.62", splines=polyline, fontname="Helvetica", fontsize=12, label="Figure 3  |  One language, more than one execution strategy", labelloc=t, labeljust=l, fontcolor="#132842"];
 node [shape=box, style="rounded,filled", color="#7794AC", fillcolor="#F4F8FC", fontcolor="#16324A", fontname="Helvetica", fontsize=11, margin="0.15,0.13"];
 edge [color="#5D7690", penwidth=1.35, arrowsize=0.75, fontname="Helvetica", fontsize=10];
 core [label="Validated typed OntoKin IR", fillcolor="#E8F6F0", color="#5E9A84"];
 interpret [label="Interpreter\nproposed first prototype\n(simple and easy to inspect)", fillcolor="#E7F1FC"];
 llvm [label="LLVM code generation\nfuture performance option\n(AOT or JIT)", fillcolor="#FFF3E7", color="#D1A365"];
 other [label="Other target(s)\nfuture, not committed\n(e.g., WebAssembly strategy)", style="rounded,dashed", fillcolor="#FFFFFF", color="#9DADB9"];
 runtime [label="Shared runtime API\nworld state + time + events + renderer adapter", fillcolor="#E8F6F0", color="#5E9A84"];
 core -> interpret [label="phase 1"];
 core -> llvm [label="possible phase 2"];
 core -> other [style=dashed, label="research"];
 interpret -> runtime; llvm -> runtime; other -> runtime [style=dashed];
 }