    },
    {
      "path": "evicted_or_changed_operand_domain",
      "cost": null,
      "obligation": "Charge lookup/reset/insertion/eviction and any repeated calculation; no assumed hit"
    },
    {
      "path": "failed_partial_or_refused",
      "cost": null,
      "obligation": "No reusable failure; retain all admitted attempts and original failure identity"
    },
    {
      "path": "generic_nine_seam_replay",
      "retained_original_units": 9,
      "obligation": "No metered angular saving remains before cache overhead"
    },
    {
      "path": "foreign_or_mutated_dispatch",
      "cost": null,
      "obligation": "Decline without changing prior events, or prove a separate authenticated route"
    },
    {
      "path": "downstream_cache_and_reader",
      "cost": null,
      "obligation": "Same bounded cache is used through export validation; independently recompute reader claims"
    }
  ],
