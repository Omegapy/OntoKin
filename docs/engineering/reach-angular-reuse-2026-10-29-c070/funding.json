    "symbols": {
      "H": "valid hits replacing complete angular regions",
      "L": "added lookup units",
      "P": "added promotion units",
      "I": "added insertion units",
      "E": "added eviction units",
      "R": "added operand-scope reset units",
      "A": "all setup/key/type/domain/authority/admission work under a justified unit map",
      "G": "retained guards/fresh claims and replayed original events",
      "F": "additional repeated/refused/fallback work not already counted",
      "delta_other": "candidate minus baseline other work, including changed outer hits, LRU displacement and reader work"
    },
    "delta_other_value": null,
    "A_value": null,
    "G_value": null,
    "F_value": null,
    "positive_condition": "9*H > L+P+I+E+R+A+G+F+delta_other",
    "condition_established": false
  },
  "paths": [
    {
      "path": "existing_complete_group_hit",
