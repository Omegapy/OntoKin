        },
        {
          "pattern": "^[0-7][0-9a-f]{15}$"
        },
        {
          "not": {
            "const": "0000000000000000"
          }
        }
      ],
      "description": "Strictly positive finite binary64 scalar; input/domain limits remain mandatory semantic checks."
    },
