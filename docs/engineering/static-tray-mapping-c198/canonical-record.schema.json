  "$defs": {
    "f64": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "allOf": [
        {
          "not": {
            "pattern": "^(?:7ff|fff)[0-9a-f]{13}$"
          }
        },
        {
          "not": {
            "const": "8000000000000000"
          }
        }
      ],
      "description": "Canonical finite IEEE-754 binary64 bit pattern in eight big-endian bytes, sixteen lowercase hex digits. Negative zero, NaN and infinity forbidden. Field-specific numeric bounds require decoded semantic validation."
    },
    "positiveF64": {
      "allOf": [
