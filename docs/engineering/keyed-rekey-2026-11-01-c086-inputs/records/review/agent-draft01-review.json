  "baseline": "f4c90c04b9b381de73d46715d52e68f588e49e4f",
  "findings": [
    {
      "id": "A-FINITE-CONTROLS",
      "disposition": "supported",
      "detail": "The .18 control is explicitly scoped to authored base/repaired/restored/higher-budget states; its conditional literal branches are not a general oracle for arbitrary rename maps."
    },
    {
      "id": "A-EXACT-PAYLOAD",
      "disposition": "supported",
      "detail": "Original String payloads left/right select unchanged dimensions, finishes and mounts; rekey changes only generated keys. Expected removed/added first-left identity and unchanged first-right/sibling/marker follow source math."
    },
    {
      "id": "A-ANCESTRY",
      "disposition": "supported",
      "detail": "The .18 catalog merge and .19 zip establish original payload entries. All inherited zip records must retain old keys; new seven-field records carry left-to-front.left and right-to-right."
    },
    {
      "id": "A-COLLISION",
      "disposition": "supported",
      "detail": "Duplicate candidate maps both old keys to right; canonical left then right yields first_old_key left and duplicate_old_key right. Primary is self token in panel callback; related entries are catalog left then right, although catalog authored right before left."
    },
    {
      "id": "A-CHECKPOINTS",
      "disposition": "supported",
      "detail": "Workflow A07 lists all four adopted-draft stages and maximum-256 matches core fixture case."
    },
    {
      "id": "A-PENDING",
      "disposition": "pending",
      "detail": "Untouched-.18 preflight, complete numeric/raw-JSON delivery allowances, supplied-byte adversaries, actual validation and direct capture review are not established by this source review."
    }
  ],
