ontokin "0.19";
module MembershipWorkaround @ "membership-workaround";
profile "keyed-rekey-0.1";

public fn selected_width @ "selected-width"(values: Keyed<Length>, query: String, fallback: Length) -> Length {
    return if reduce_keyed<Bool>(values, false, (found, key, value) -> found or key == query)
        then values[query] else fallback;
}

public class Panel @ "panel" {
    public param query @ "query": String = "left";
    public derive width @ "width": Length = selected_width(keyed<Length>{"left": 2[m]}, self.query, 1[m]);
    geometry = box(vec3(self.width, 1[m], 1[m]));
    physical = no_body();
}

scene Demo @ "demo" {
    duration = 1[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object present @ "present": Panel {}
    object missing @ "missing": Panel { query = "right"; }
}
