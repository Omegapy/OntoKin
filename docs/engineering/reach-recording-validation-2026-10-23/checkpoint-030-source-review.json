  "findings": [
    {
      "id": "late-hook-optional-slot-read",
      "status": "resolved",
      "description": "A comparison context created before tracing was enabled could inspect optional raw Fraction slots before the full native gate. A hook could replace a slot descriptor between the cheap descriptor check and the raw read, introducing a foreign call before ordinary fallback.",
      "demonstrated_source_commit": "3b0c2670b5b889a465352562b1219baed77d1302",
      "demonstrated_failure_report": "execution/candidate-hook-regression-001/report.json",
      "demonstrated_failure_log": "execution/candidate-hook-regression-001/tests.log",
      "demonstrated_result": "2 methods executed; late-trace method errored with the targeted optional-slot-read marker; late-profile method passed; failed status retained.",
      "repair_commit": "6a9fb22fb8ca901e18d315406cbca667f2ef8321",
      "repair": "Saved native gettrace/getprofile queries now decline active hooks before every optional descriptor/slot read, including hooks installed after context creation. Potential equality still requires the full native gate and fresh current operand reads.",
      "verified_report": "execution/candidate-focused-005/report.json",
      "verification_scope": "Root-executed 115-method focused suite, zero failures/errors/skips and stable inputs; reviewed record, not re-executed by reviewer."
    },
    {
      "id": "replaced-algebra-signature",
      "status": "resolved",
      "description": "Initial integration passed the new optional keyword to an original-control replacement that retained the seven-positional-argument interface.",
      "demonstrated_failure_report": "execution/candidate-focused-001/report.json",
      "repair_commit": "a6c15941ac720bdae93daeafc624f9a5b10bf6a8",
      "repair": "Pass the optional comparison context only to the saved native complete-algebra function with its saved code; call all replacements through the original seven positional arguments.",
      "verified_report": "execution/candidate-focused-002/report.json"
    },
    {
      "id": "initial-source-draft-repairs",
      "status": "resolved_before_first_focused_execution",
      "description": "Read-only review of the initial draft found a prebound ordinary decoder, a substitutable receipt map entry and a missing comparison-context arithmetic binding.",
      "repair": "Ordinary decoder lookup remains dynamic for every field; an immutable completed-receipt identity tuple rejects substituted lookup entries; complete algebra ignores contexts belonging to another arithmetic object.",
      "evidence": "Dedicated regression methods are included in the final 115-method focused report. No runtime failure from the pre-repair author draft is claimed."
    }
  ],
  "preserved_proof_obligations": [
    "Only earlier completed native typed-identical group-local decodes are retained; float identity includes exact binary64 bits and signed zero, and int/float types remain distinct.",
    "Original retained decodes require before/after native gates; omissions validate input, result fields, receipt identity and owners and return distinct Fraction objects.",
    "Only current numerator-and-denominator equality can discharge a fresh required comparison; successful claims are never cached.",
    "Both operand and prospective cross-product guards remain, with actual lazy admission and post-charge checks.",
    "The cheap slot filter only declines; saved primitive readers and descriptor pins prevent foreign preliminary field calls, and active hooks decline before optional reads.",
    "Both threshold admit_continuation calls and flags, current owner/receipt checks, both actual width squares, both quarter plans, maxima and tolerances remain.",
    "Custom callbacks, work observers, foreign scalar dispatch and unsupported live operand domains use ordinary arithmetic.",
    "Limits remain 100000 operations,30000 ms,32768 operand bits,256 numerical cache entries; the 512-category metadata inspection bound is separate."
  ],
