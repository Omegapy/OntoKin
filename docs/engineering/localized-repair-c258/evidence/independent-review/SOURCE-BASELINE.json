          "start_byte": 1179,
          "end_byte": 1454,
          "text": "mounts = keyed<Vec3<Length>> {\n            \"bottom\": vec3(0[m], -1.2[m], 0[m]),\n            \"lower\": vec3(0[m], -0.6[m], 0[m]),\n            \"middle\": vec3(0[m], 0[m], 0[m]),\n            \"upper\": vec3(0[m], 0.6[m], 0[m]),\n            \"top\": vec3(0[m], 1.2[m], 0[m])\n        };"
        },
        {
          "filename": "hinges.ok",
