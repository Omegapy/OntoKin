          "start_byte": 70,
          "end_byte": 149,
          "text": "public fn three_mounts @ \"three-mounts\"(spacing: Length) -> Keyed<Vec3<Length>>"
        },
        {
          "filename": "hinges.ok",
          "source_id": "package:example.hinges@1.0.0",
