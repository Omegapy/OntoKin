          "start_byte": 1110,
          "end_byte": 1290,
          "text": "public follow mounting @ \"mounting\" {\n        parent = self.parent_frame;\n        child = self;\n        offset = pose(self.parent_frame, self.mount_offset, quat(1, 0, 0, 0));\n    }"
