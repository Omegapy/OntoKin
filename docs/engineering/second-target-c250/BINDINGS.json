  "claims": [
    {
      "claim": "MANUAL callback mode is 2; changing it temporarily toggles active and restores it; detached state prevents in-tree cache clearing. Internal processing flags are separately observed.",
      "sources": [
        "AnimationMixer.xml",
        "animation_mixer.cpp:438-516"
      ],
      "nativeProof": false
    },
    {
      "claim": "Stopped assigned-animation setter selects pointer and position 0 then emits current_animation_changed; current_animation remains empty while stopped. is_animation_active is the public pointer guard.",
      "sources": [
        "animation_player.cpp:617-638",
        "animation_player.cpp:713-724",
        "animation_player.cpp:999",
        "AnimationPlayer.xml",
        "Object.xml"
      ],
      "nativeProof": false
    },
    {
      "claim": "Detached Node3D global-transform getter rejects and returns a default. Tree attachment has notifications and signals and is a separate deferred boundary.",
      "sources": [
        "node_3d.cpp:641-670",
        "Node3D.xml",
        "node.cpp:317-377"
      ],
      "nativeProof": false
    }
  ],
  "limits": [
    "Held source only; no parser or native execution or installed-build binding",
    "One original fixture; no arbitrary player repair",
    "Fresh C249 capture once then policy-aware read-only boundary inventory",
    "Signal receiver count is retained; arbitrary callable payload omitted and any receiver refuses",
    "Readbacks detect observed lasting drift only; no atomicity or transient/concurrent-mutation proof",
    "All Python identity, setter, callback and lifecycle behavior is synthetic",
    "No seek, tree attachment, world observations, serialization, raw sealing or 126-pose result"
  ]
}
