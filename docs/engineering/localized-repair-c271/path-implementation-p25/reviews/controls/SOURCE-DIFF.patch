+    _require(literal == paths, "UNSUPPORTED", "Inspector RTLDLIST is not the exact reviewed literal list")
+    _rtld_require(paths == list(RTLD_CANDIDATES), "RP-CANDIDATE", operation="candidate_order")
+    return paths
