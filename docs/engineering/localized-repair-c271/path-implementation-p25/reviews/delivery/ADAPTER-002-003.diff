+    def test_S10_model_shape_and_guard_relations_are_closed(self):
+        reports = []
+        mutations = (
+            ("boolean_identity", lambda model: model["components"][0]["identity"].__setitem__(0, True)),
+            ("reordered_components", lambda model: model["components"].reverse()),
+            ("extra_component", lambda model: model["components"].append(deepcopy(model["components"][-1]))),
+            ("missing_component", lambda model: model["components"].pop()),
+            ("alternate_target", lambda model: model["components"][1].__setitem__("target", "/usr/lib")),
+            ("extra_witness_key", lambda model: model["absences"][0].__setitem__("approved", True)),
+        )
+        for name, mutate in mutations:
+            model = initial_model()
+            mutate(model)
+            fs = SyntheticOS(materialize(CASES["P05"]), "P05")
+            error = self.proof_error(fs, model)
+            self.assertEqual((error.code, error.details["rule_id"]), ("CHI-PLAN", "RP-SHAPE"))
+            self.assertEqual(fs.trace, [])
+            reports.append({"case": name, "error": error.as_dict(), "syscalls": 0})
+        for name in ("literal_descendant_guard", "symlink_parent_guard", "boolean_parent_inode"):
+            model = initial_model()
+            guards = guards_for(model)
+            if name == "literal_descendant_guard":
+                guards.append({"path": X32, "parent": "/libx32", "parent_device": 71, "parent_inode": 1})
+            elif name == "symlink_parent_guard":
+                row = next(row for row in guards if row["path"] == "/usr/lib/ld-linux.so.2")
+                row["parent"] = "/lib"
+            else:
+                row = next(row for row in guards if row["path"] == "/libx32")
+                row["parent_inode"] = True
+            with self.assertRaises(inspection.HostInspectionError) as caught:
+                inspection._check_rtld_guard_relations(model, guards)
+            self.assertEqual((caught.exception.code, caught.exception.details["rule_id"]), ("CHI-PATH", "RP-IDENTITY"))
+            reports.append({"case": name, "error": caught.exception.as_dict()})
+        self.retain("S10", {"expected": "Closed model and exact physical guard projection; no Boolean integers or descendant/symlink-parent absence guard", "cases": reports})
