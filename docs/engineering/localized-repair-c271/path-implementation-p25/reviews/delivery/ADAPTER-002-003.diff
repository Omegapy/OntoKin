+    def test_S09_final_launch_clock_faults_keep_existing_handling(self):
+        reports = []
+        for kind in ("supervisor_stop", "path_shaped_callback"):
+            with self.subTest(kind=kind):
+                c = materialize(CASES["P05"])
+                fs = SyntheticOS(c, "P05")
+                sentinel = (MockStop("synthetic command clock expired") if kind == "supervisor_stop" else
+                            inspection.HostInspectionError("PATH", "synthetic callback identity", state="TIMEOUT",
+                                                           details={"stage": "rtld_paths"}))
+                class Clock(MockClock):
+                    def check(self, stage_end=None):
+                        super().check(stage_end)
+                        if any(row["path"] == "/usr" for row in fs.live.values()):
+                            raise sentinel
+                plan = {"schema": PAIR["plan_schema"], "host_static": {"platform": {"boot_id": "synthetic"}, "path_guards": [],
+                        "resolution": {"rtld_paths": c["model"], "origin_rpath": {"subject": {"path": "/synthetic/python"}}}}}
+                validated = SimpleNamespace(plan=plan, _metadata={"input_snapshot": {}, "origin_kernel_witness": {},
+                                             "rtld_path_snapshot": {}}, _runtime={}, _helpers=(None, SimpleNamespace(Stop=MockStop)))
+                def operational(*a, check=lambda: None, **k):
+                    with patch.object(inspection, "os", fs):
+                        return inspection._check_rtld_paths(c["model"], BASE_BINDING, check=lambda: (check(), fs.check()))
+                with ExitStack() as stack:
+                    for name, value in (("_platform", plan["host_static"]["platform"]), ("_check_guards", None),
+                                        ("_origin_subject_observation", {}), ("_check_kernel_origin", {})):
+                        stack.enter_context(patch.object(inspection, name, return_value=value))
+                    stack.enter_context(patch.object(inspection, "_check_rtld_operational_paths", side_effect=operational))
+                    with self.assertRaises(inspection.HostInspectionError) as caught:
+                        inspection._launch_check(validated, Clock(total_ms=5000), 1003.0)
+                error = caught.exception
+                if kind == "supervisor_stop":
+                    self.assertEqual((error.code, error.state), ("CHI-PROCESS", "TIMEOUT"))
+                    self.assertIs(error.cause, sentinel)
+                else:
+                    self.assertIs(error, sentinel)
+                self.assertFalse(fs.live)
+                self.assertEqual(sorted(fs.opened), sorted(fs.closed))
+                reports.append({"kind": kind, "same_cause": error.cause is sentinel, "same_error": error is sentinel,
+                                "error": error.as_dict(), **fs.summary()})
+        self.retain("S09", {"expected": "Only path-generated refusals receive new drift wrapper; callback identity/clock behavior unchanged", "cases": reports})
