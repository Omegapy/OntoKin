 "rules": "disposition 001's dispositions and revision_rules; every other change in stated_additions, for freeze review 002",
 "changes": [
  {
   "id": "D-01",
   "finding": "FR-01 (a), (b)",
   "what": "'launch' (new): the background launch of the shell member alone, one call per command, never retried; each command's 'timer_shell' (new member, from launch.timer_template); stop rules 2 and 3",
   "where": [
    "/launch",
    "/commands/*/timer_shell",
    "/stop_rules/1",
    "/stop_rules/2"
   ]
  },
  {
   "id": "D-02",
   "finding": "FR-01 (c), (d)",
   "what": "'overrun' (new) replaces stop rule 9 with the six steps; candidates and selection rule; C16, C17 and C19 gain an 'overrun' member (candidates, select_shell, the IDs of their probes and stops); 25 capture commands (17 probes, 8 stops), phase 'capture', each with argv and absent outputs; 'capture_commands' lists them",
   "where": [
    "/overrun",
    "/stop_rules/9",
    "/commands/C16|C17|C19/overrun",
    "/capture_commands",
    "/commands (phase capture)"
   ]
  },
  {
   "id": "D-03",
   "finding": "FR-02",
   "what": "every main command C01 to C19 appends its .L's expect and, for C16, C17 and C19, its .P's expect, in full, to its own expect; stop rule 4; one classification row each",
   "where": [
    "/commands/C*/expect",
    "/commands/C*/classification",
    "/stop_rules/3"
   ]
  },
  {
   "id": "D-04",
   "finding": "FR-03",
   "what": "C17's expect: each process event subprocess.Popen, each argv[0] one of the bound Node and the bound Git; C06's and C07's: each subprocess.Popen, each argv[0] the bound Git; one classification row each",
   "where": [
    "/commands/C06|C07|C17/expect",
    "/commands/C06|C07|C17/classification"
   ]
  },
  {
   "id": "D-05",
   "finding": "FR-04",
   "what": "stop rule 6: C17's trio is one indivisible row; C17's classification",
   "where": [
    "/stop_rules/5",
    "/commands/C17/classification"
   ]
  },
  {
   "id": "D-06",
   "finding": "FR-05",
   "what": "the author's notes use 25 directories, 18 files and 43 entries; nothing in the freeze's JSON or the preparation changes",
   "where": [
    "FREEZE-AUTHOR-NOTES-002.md"
   ]
  },
  {
   "id": "D-07",
   "finding": "FR-06",
   "what": "classification rows: C02 (state_equals_host false is IMPLEMENTATION; a boot change HOST), C03 to C05 (SOURCE or PYTHON is PLAN or IMPLEMENTATION), C12 and C13 (a difference that exporting C causes is PLAN), C17 (another bootstrap refusal of a positive case is IMPLEMENTATION; an EVIDENCE refusal at setUpClass is PLAN), C19 (MC30-probe refusing after the environment check with another message is PLAN; MC36 NOT_RUN)",
   "where": [
    "/commands/C02|C03|C04|C05|C12|C13|C17|C19/classification"
   ]
  },
  {
   "id": "D-08",
   "finding": "FR-07",
   "what": "P00 (new, first in 'order', phase precondition): /usr/bin/shasum -a 256 --strict -c on freeze 002's SHA256SUMS.txt and on P00's second list (new document s7/p00-freeze-001-rebound.sha256sums.txt, bound); stop rule 1; preconditions; D02's re-evaluation covers it; its records are not in before_preparation, as P01's",
   "where": [
    "/commands/P00",
    "/order/0",
    "/stop_rules/0",
    "/preconditions",
    "/preparation/verification",
    "/bindings (freeze002:...)"
   ]
  },
  {
   "id": "D-09",
   "finding": "FR-09",
   "what": "limits.this_freeze: the default temporary-cohort path is not exercised",
   "where": [
    "/limits/this_freeze"
   ]
  },
  {
   "id": "D-10",
   "finding": "FR-12",
   "what": "n04.assumption (new) names the user and the CF file; C17's expect checks the CF file's SHA-256; the gap is stated in limits.this_freeze; one classification row",
   "where": [
    "/n04/assumption",
    "/n04/how_shown/2",
    "/commands/C17/expect",
    "/limits/this_freeze"
   ]
  },
  {
   "id": "D-11",
   "finding": "disposition 001 (mc11_reviewed_list); revision rule 6",
   "what": "the MC11 reviewed list is bound directly (bindings 'review001:MC11-REVIEWED-LIST-001.json'); deferred_inputs is empty; C01's argv holds its digest in place of the placeholder, so C01's wrapper predicates are rebuilt and its equals_sha256_of rule goes; decisions item 7",
   "where": [
    "/bindings",
    "/deferred_inputs",
    "/deferred_arguments",
    "/commands/C01",
    "/decisions/6"
