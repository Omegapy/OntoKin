  },
  {
   "id": "D-12",
   "finding": "revision rules 2 and 6 (FREEZE-002.json's digest deferred)",
   "what": "the checker's --freeze and --freeze-sha256 arguments of P01, D02, Q04 and every .X name FREEZE-002.json and the placeholder '<FREEZE-002.json SHA-256>'; their wrapper predicates are rebuilt; deferred_arguments",
   "where": [
    "/commands/P01|D02|Q04|*.X"
   ]
  },
  {
   "id": "D-13",
   "finding": "revision rules 3 and 4",
   "what": "every unchanged document is rebound at its W2-freeze-001 path with its digest (the 120 bindings of freeze 001, unchanged); attempt s7-001's paths are kept (attempt_paths); revision_of, places, status, id, author",
   "where": [
    "/revision_of",
    "/attempt_paths",
    "/places",
    "/status",
    "/id",
    "/author"
   ]
  },
  {
   "id": "D-14",
   "finding": "the reviews' records",
   "what": "carried_findings gains FR-01 to FR-12; decisions gain items 12 to 15; open_questions are freeze 002's; freeze 001's questions move to answered_questions_001 with review 001's answers; tools.new_in_this_freeze; totals (P00, the capture commands, the Director's starts; Node and other unchanged); failure_capture notes",
   "where": [
    "/carried_findings",
    "/decisions",
    "/open_questions",
    "/answered_questions_001",
    "/tools",
    "/totals",
    "/failure_capture"
   ]
  }
 ],
 "stated_additions": [
  {
   "id": "A-1",
   "rule": "overrun step 5",
   "change": "after the wrapper exits, the command's .P runs too (with FC-P6 for an established target whose stop has not run), besides the .L of section 6 step 5",
   "reason": "FR-04 (d) lets C17 record starts after the overrun probe; FAILURE-CAPTURE section 6 step 4 asks for a probe of every recorded start, and section 8's capture record for each one's probe; the .P is already frozen and reviewed"
  },
  {
   "id": "A-2",
   "rule": "P00",
   "change": "--strict in shasum's argv",
   "reason": "this shasum (Perl, 6.02) skips an improperly formatted line without failing unless --strict is given, so a damaged digest field would leave its file unchecked with exit 0"
  },
  {
   "id": "A-3",
   "rule": "overrun steps 1 and 6",
   "change": "a second run of the command's own timer from the overrun decides when the owner is told that the wrapper has not exited",
   "reason": "step 6 needs an executable criterion for 'never exits'; the same frozen text, no new tool"
  },
  {
   "id": "A-4",
   "rule": "trees",
   "change": "the freeze 002 directory is a tree root (no .DS_Store)",
   "reason": "as freeze 001's own directory was: it now holds a bound input (P00's second list) and the freeze itself"
  },
  {
   "id": "A-5",
   "rule": "launch.after",
   "change": "a timer's 'no-clock' or other output is a PLAN deviation that stops S7 after the command's .L, .P and .X; a timer line after the command's task ended has no effect",
   "reason": "the timer is new tooling and the launch must say what each of its outputs means"
  },
  {
   "id": "A-6",
   "rule": "stop rule 12",
   "change": "Q01 to Q04 run only when every wrapper started has exited",
   "reason": "after an overrun whose wrapper never exits, the post checks would observe a command still running"
  },
  {
   "id": "A-7",
   "rule": "P00's expect",
   "change": "besides its exit, D02 checks P00's empty stderr, that stdout names FREEZE-002.json, the second list and the checker as OK, and holds no FAILED",
   "reason": "so that D02's re-evaluation shows both lists were read; the Director's decision before P01 still reads the exit file alone"
  }
 ],
