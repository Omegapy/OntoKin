  "implementation_predicates": [
    {
      "id": "PC01",
      "anchor": "provider:_verify_inspection; probe:verifyInspection",
      "requirement": "Exact two command vectors; process argv/environment equal enclosing receipt; actual positive integer PID equals process group; returncode zero, handles closed, cleanup passed/reaped/group absent, error null; finite monotonic duration in [0,5] seconds."
    },
    {
      "id": "PC02",
      "anchor": "provider:_verify_host; probe:verifyHost",
      "requirement": "Exact Linux platform/boot identity; Python executable/version/seven package pins; selected Node archive and executable byte/size/mode constants; actual Node version and process.execPath at probe."
    },
    {
      "id": "PC03",
      "anchor": "provider:_verify_host; probe:verifyHost",
      "requirement": "Every scalar/list role participates in exact named alias set; resolved aliases form exact files key set; complete nonempty unique runtime role lists, no extra or omitted files."
    },
    {
      "id": "PC04",
      "anchor": "provider:_elf_interpreter; probe:elfInterpreter",
      "requirement": "Statically parsed PT_INTERP equals named role; ldd first-line interpreter literal equals #! plus role; do not loosen aliases or shebang to force admission."
    },
    {
      "id": "PC05",
      "anchor": "provider:_verify_host; probe:verifyHost",
      "requirement": "ldd observed absolute path set equals shared_libraries union elf_interpreter. Probe also rejects not found in stderr; stricter plan must reject unresolved output in both streams."
    },
    {
      "id": "PC06",
      "anchor": "provider:_verify_host; probe:verifyHost",
      "requirement": "Host timestamp follows both successful inspection finishes; timestamps cannot be in the future. Sidecar proves stronger freshness/source-chain requirements."
    },
    {
      "id": "PC07",
      "anchor": "provider:_selection; operations.md",
      "requirement": "Expected config digest selected outside config; new HOST authoring must not require this completed config as its bootstrap authority."
    },
    {
      "id": "PC08",
      "anchor": "supervisor:Clock/run_process",
      "requirement": "5000-ms total inspection clock includes its unchanged 2000-ms cleanup reserve; no 5000+2000 extension or reset. Callback records immediate actual start; Popen failure can have zero start and no successful inspection."
    },
    {
      "id": "PC09",
      "anchor": "P06 CONTROL-DISPOSITIONS.json",
      "requirement": "H01 coherent-unapproved-input and H02 direct refusal require separately declared actual Node counts; H03 retains all original seven outcomes with three original CPU starts. None is passed by static review."
    }
  ]
