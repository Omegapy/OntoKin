ontokin "0.21";
module TorqueCases @ "torque-cases";
profile "keyed-membership-0.1";

import rotors @ "rotors" from "fixture.torque-carriers" version "1.0.0" digest "sha256:e0452a1de23724a65fe3ca50695e1cde138c138b291ec3b7acee850464e75e10";

import values @ "values" from "fixture.torque-values" version "1.0.0" digest "sha256:0a08629a8ec25f55bf372a1e1849e550fbc1598d41ed2d6b1f8c6a39b4ce80c7";

public fn torque @ "contextual-torque"(about: Torque, world_z: Time) -> Torque {
    return about;
}

scene Demo @ "demo" {
    duration = 2[s];
    gravity = vector(world, 0[m/s^2], 0[m/s^2], 0[m/s^2]);
    object ball @ "ball": rotors.Rotor {
        body_mass = 2.5[kg];
        body_radius = 1[m];
        marker_radius = 1[m];
        placement = pose(world, vec3(0[m], 0[m], 0[m]), quat(1, 0, 0, 0));
        velocity = vector(world, 0[m/s], 0[m/s], 0[m/s]);
        omega = vector(world, 0[rad/s], 0[rad/s], 0[rad/s]);
    }
    object sibling @ "sibling": rotors.Rotor {
        placement = pose(world, vec3(5[m], 0[m], 0[m]), quat(1, 0, 0, 0));
    }
    at 0[s] sequence {
        force ball @ "pure-control" using vector(world, torque(values.torque(1[N*m]), values.duration()) / 1[m], 0[N], 0[N]) for values.duration();
    }
}
