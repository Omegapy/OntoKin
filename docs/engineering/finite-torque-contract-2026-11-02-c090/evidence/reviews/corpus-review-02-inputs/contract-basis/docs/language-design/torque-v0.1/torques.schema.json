{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontokin.org/schemas/torque-v0.1/torques.schema.json",
  "title": "Complete finite torque state projection, torque-0.1",
  "description": "Closed new projection; exact source, chronology, rational reduction/bit bounds, finite native scalar, authority and complete record membership require independent semantic verification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "active": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "net_torque_n_m": {
      "$ref": "#/$defs/number"
    },
    "angular_acceleration_rad_per_s2": {
      "oneOf": [
        {
          "$ref": "#/$defs/number"
        },
        {
          "type": "null"
        }
      ]
    },
    "axis": {
      "oneOf": [
        {
          "$ref": "#/$defs/axis"
        },
        {
          "type": "null"
        }
      ]
    },
    "rotation_route": {
      "enum": [
        "legacy",
        "split"
      ]
    },
    "rotation_anchor_seconds": {
      "oneOf": [
        {
          "$ref": "#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "signed_angular_speed_rad_per_s": {
      "oneOf": [
        {
          "$ref": "#/$defs/number"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase_since_anchor_rad": {
      "oneOf": [
        {
          "$ref": "#/$defs/number"
        },
        {
          "type": "null"
        }
      ]
    },
    "angular_acceleration_reference_rad_per_s2": {
      "oneOf": [
        {
          "$ref": "#/$defs/rational"
        },
        {
          "type": "null"
        }
      ]
    },
    "angular_error_bound_rad": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonnegative_rational"
        },
        {
          "type": "null"
        }
      ]
    },
    "angular_speed_error_bound_rad_per_s": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonnegative_rational"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "completed_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "last_change_time_seconds": {
      "oneOf": [
        {
          "$ref": "#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_changes": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/change"
      }
    }
  },
  "required": [
    "active",
    "net_torque_n_m",
    "angular_acceleration_rad_per_s2",
    "axis",
    "rotation_route",
    "rotation_anchor_seconds",
    "signed_angular_speed_rad_per_s",
    "phase_since_anchor_rad",
    "angular_acceleration_reference_rad_per_s2",
    "angular_error_bound_rad",
    "angular_speed_error_bound_rad_per_s",
    "started_count",
    "completed_count",
    "last_change_time_seconds",
    "last_changes"
  ],
  "$defs": {
    "source_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "start_byte",
        "end_byte"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stable_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "element_id": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "record": {
      "type": "object",
      "properties": {
        "torque_key": {
          "$ref": "#/$defs/stable_key"
        },
        "torque_element_id": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/stable_key"
            },
            {
              "$ref": "#/$defs/stable_key"
            },
            {
              "const": "torque"
            },
            {
              "$ref": "#/$defs/stable_key"
            }
          ],
          "items": false
        },
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "target_element_id": {
          "$ref": "#/$defs/element_id"
        },
        "program_revision": {
          "$ref": "#/$defs/revision"
        },
        "source_location": {
          "$ref": "#/$defs/source_location"
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "activation_time_seconds": {
          "$ref": "#/$defs/time"
        },
        "duration_seconds": {
          "$ref": "#/$defs/time"
        },
        "completion_time_seconds": {
          "$ref": "#/$defs/time"
        },
        "axis": {
          "$ref": "#/$defs/axis"
        },
        "torque_n_m": {
          "$ref": "#/$defs/number"
        },
        "operand_location": {
          "$ref": "#/$defs/source_location"
        },
        "duration_location": {
          "$ref": "#/$defs/source_location"
        }
      },
      "required": [
        "torque_key",
        "torque_element_id",
        "target_path",
        "target_element_id",
        "program_revision",
        "source_location",
        "sequence_index",
        "activation_time_seconds",
        "duration_seconds",
        "completion_time_seconds",
        "axis",
        "torque_n_m",
        "operand_location",
        "duration_location"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "torque_key": {
          "$ref": "#/$defs/stable_key"
        },
        "torque_element_id": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/stable_key"
            },
            {
              "$ref": "#/$defs/stable_key"
            },
            {
              "const": "torque"
            },
            {
              "$ref": "#/$defs/stable_key"
            }
          ],
          "items": false
        },
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "target_element_id": {
          "$ref": "#/$defs/element_id"
        },
        "program_revision": {
          "$ref": "#/$defs/revision"
        },
        "source_location": {
          "$ref": "#/$defs/source_location"
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "activation_time_seconds": {
          "$ref": "#/$defs/time"
        },
        "duration_seconds": {
          "$ref": "#/$defs/time"
        },
        "completion_time_seconds": {
          "$ref": "#/$defs/time"
        },
        "axis": {
          "$ref": "#/$defs/axis"
        },
        "torque_n_m": {
          "$ref": "#/$defs/number"
        },
        "operand_location": {
          "$ref": "#/$defs/source_location"
        },
        "duration_location": {
          "$ref": "#/$defs/source_location"
        },
        "kind": {
          "enum": [
            "started",
            "completed"
          ]
        }
      },
      "required": [
        "torque_key",
        "torque_element_id",
        "target_path",
        "target_element_id",
        "program_revision",
        "source_location",
        "sequence_index",
        "activation_time_seconds",
        "duration_seconds",
        "completion_time_seconds",
        "axis",
        "torque_n_m",
        "operand_location",
        "duration_location",
        "kind"
      ],
      "additionalProperties": false
    },
    "axis": {
      "enum": [
        "world_x",
        "world_y",
        "world_z"
      ]
    },
    "number": {
      "type": "number"
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)$",
          "maxLength": 9866
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 9865
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "nonnegative_rational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "maxLength": 9866
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 9865
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "axis": {
            "type": "null"
          }
        },
        "required": [
          "axis"
        ]
      },
      "then": {
        "properties": {
          "angular_acceleration_rad_per_s2": {
            "type": "null"
          },
          "signed_angular_speed_rad_per_s": {
            "type": "null"
          },
          "angular_acceleration_reference_rad_per_s2": {
            "type": "null"
          },
          "angular_error_bound_rad": {
            "type": "null"
          },
          "angular_speed_error_bound_rad_per_s": {
            "type": "null"
          },
          "rotation_route": {
            "const": "legacy"
          },
          "started_count": {
            "const": 0
          },
          "completed_count": {
            "const": 0
          },
          "active": {
            "maxItems": 0
          },
          "last_changes": {
            "maxItems": 0
          },
          "last_change_time_seconds": {
            "type": "null"
          },
          "net_torque_n_m": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "started_count": {
            "minimum": 1
          },
          "angular_acceleration_rad_per_s2": {
            "$ref": "#/$defs/number"
          },
          "signed_angular_speed_rad_per_s": {
            "$ref": "#/$defs/number"
          },
          "angular_acceleration_reference_rad_per_s2": {
            "$ref": "#/$defs/rational"
          },
          "angular_error_bound_rad": {
            "$ref": "#/$defs/nonnegative_rational"
          },
          "angular_speed_error_bound_rad_per_s": {
            "$ref": "#/$defs/nonnegative_rational"
          },
          "last_change_time_seconds": {
            "$ref": "#/$defs/time"
          },
          "last_changes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rotation_route": {
            "const": "legacy"
          }
        },
        "required": [
          "rotation_route"
        ]
      },
      "then": {
        "properties": {
          "rotation_anchor_seconds": {
            "type": "null"
          },
          "phase_since_anchor_rad": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "rotation_anchor_seconds": {
            "$ref": "#/$defs/time"
          },
          "phase_since_anchor_rad": {
            "$ref": "#/$defs/number"
          },
          "axis": {
            "$ref": "#/$defs/axis"
          }
        }
      }
    }
  ]
}
