{
  "$id": "https://omegapy.github.io/OntoKin/torque-v0.1/recording-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "axis_domain": {
      "const": [
        "world_x",
        "world_y",
        "world_z"
      ]
    },
    "descendants": {
      "const": "fixed_rigid_massless_visual_markers"
    },
    "live_solver_embedded": {
      "const": false
    },
    "motion_model": {
      "const": "finite_cartesian_world_axis_external_couple_on_free_own_sphere"
    },
    "quantization_contract": {
      "const": "ontokin.torque-quantization/0.1"
    },
    "schema_version": {
      "const": "ontokin.torque-recording/0.1"
    },
    "source_profile": {
      "const": "torque-0.1"
    },
    "transform_policy": {
      "const": "all_nodes_are_roots_with_baked_world_poses"
    }
  },
  "required": [
    "schema_version",
    "source_profile",
    "motion_model",
    "axis_domain",
    "descendants",
    "transform_policy",
    "quantization_contract",
    "live_solver_embedded"
  ],
  "title": "Fixed-axis torque recording profile",
  "type": "object"
}
